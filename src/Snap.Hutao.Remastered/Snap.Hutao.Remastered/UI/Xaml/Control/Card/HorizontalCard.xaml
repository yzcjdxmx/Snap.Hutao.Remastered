<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme">

    <Style BasedOn="{StaticResource DefaultHorizontalCardStyle}" TargetType="shuxcc:HorizontalCard"/>

    <Style x:Key="DefaultHorizontalCardStyle" TargetType="shuxcc:HorizontalCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxcc:HorizontalCard">
                    <Grid Background="{TemplateBinding Background}" Style="{ThemeResource GridShimmerStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Child="{TemplateBinding Left}"/>
                        <Border
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Child="{TemplateBinding Right}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="shuxcth:MaterialBackground.GlassBrush" Value="{ThemeResource HutaoSurfaceBrush}"/>
        <Setter Property="shuxcth:MaterialBackground.NativeBrush" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
    </Style>

</ResourceDictionary>