<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme">

    <Style BasedOn="{StaticResource DefaultCardProgressBarStyle}" TargetType="shuxcc:CardProgressBar"/>

    <Style x:Key="DefaultCardProgressBarStyle" TargetType="shuxcc:CardProgressBar">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxcc:CardProgressBar">
                    <Grid
                        MinHeight="{TemplateBinding MinHeight}"
                        Background="{TemplateBinding Background}"
                        Style="{ThemeResource GridShimmerStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            Grid.ColumnSpan="2"
                            MinHeight="{TemplateBinding MinHeight}"
                            Margin="-1"
                            Background="Transparent"
                            BorderBrush="{x:Null}"
                            BorderThickness="0"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Foreground="{TemplateBinding ProgressForeground}"
                            IsIndeterminate="{TemplateBinding IsIndeterminate}"
                            Maximum="{TemplateBinding Maximum}"
                            Opacity="{ThemeResource LargeBackgroundProgressBarOpacity}"
                            Value="{TemplateBinding Value}"/>
                        <TextBlock
                            Grid.Column="0"
                            Margin="6,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding TextForeground}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{TemplateBinding Header}"/>
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding TextForeground}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{TemplateBinding Description}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TextForeground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="shuxcth:MaterialBackground.GlassBrush" Value="{ThemeResource HutaoSurfaceBrush}"/>
        <Setter Property="shuxcth:MaterialBackground.NativeBrush" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="CompactCardProgressBarStyle" TargetType="shuxcc:CardProgressBar">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="ProgressForeground" Value="{ThemeResource ProgressBarForegroundThemeBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxcc:CardProgressBar">
                    <Grid
                        MinHeight="{TemplateBinding MinHeight}"
                        Background="{TemplateBinding Background}"
                        Style="{ThemeResource GridShimmerStyle}">
                        <ProgressBar
                            Grid.RowSpan="2"
                            MinHeight="{TemplateBinding MinHeight}"
                            Margin="-1"
                            Background="Transparent"
                            BorderBrush="{x:Null}"
                            BorderThickness="0"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Foreground="{TemplateBinding ProgressForeground}"
                            IsIndeterminate="{TemplateBinding IsIndeterminate}"
                            Maximum="{TemplateBinding Maximum}"
                            Opacity="{ThemeResource LargeBackgroundProgressBarOpacity}"
                            Value="{TemplateBinding Value}"/>
                        <StackPanel Margin="8" Spacing="4">
                            <TextBlock
                                Foreground="{TemplateBinding TextForeground}"
                                Style="{ThemeResource BaseTextBlockStyle}"
                                Text="{TemplateBinding Header}"/>
                            <TextBlock
                                Foreground="{TemplateBinding TextForeground}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{TemplateBinding Description}"/>
                        </StackPanel>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TextForeground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="shuxcth:MaterialBackground.GlassBrush" Value="{ThemeResource HutaoSurfaceBrush}"/>
        <Setter Property="shuxcth:MaterialBackground.NativeBrush" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
    </Style>

</ResourceDictionary>