<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwh="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvww="using:Snap.Hutao.Remastered.UI.Xaml.View.Window.WebView2"
    xmlns:shv="using:Snap.Hutao.Remastered.ViewModel"
    xmlns:shwhr="using:Snap.Hutao.Remastered.Web.Hutao.Redeem"
    d:DataContext="{d:DesignInstance shv:TestViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Border Margin="16" Style="{ThemeResource AcrylicBorderCardStyle}">
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    Margin="1,0,0,5"
                    Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}"
                    Text="WebView"/>
                <cwc:SettingsCard Header="Adopt Calculator" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="http://webstatic.mihoyo.com/ys/event/e20200923adopt_calculator/index.html?bbs_presentation_style=fullscreen&amp;bbs_auth_required=true&amp;utm_source=bbs&amp;utm_medium=mys&amp;utm_campaign=GameRecord"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Community Game Record" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="https://webstatic.mihoyo.com/app/community-game-records/index.html"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="SignIn Reward" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="https://act.mihoyo.com/bbs/event/signin/hk4e/index.html?act_id=e202311201442471"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="State"/>
                <cwc:SettingsCard Header="Reset Guide State">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_5460"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <Button
                                Command="{Binding ResetGuideStateCommand}"
                                Content="Reset (No restart)"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassButton
                                materialtheme:ControlMaterialState.IsManaged="True"
                                Command="{Binding ResetGuideStateCommand}"
                                Content="Reset (No restart)"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Resize MainWindow">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_5776"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <Button
                                Command="{Binding ResetMainWindowSizeCommand}"
                                Content="Reset"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassButton
                                materialtheme:ControlMaterialState.IsManaged="True"
                                Command="{Binding ResetMainWindowSizeCommand}"
                                Content="Reset"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Condition Override"/>

                <cwc:SettingsCard Header="Override Elevation Requirement">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_6212"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <ToggleSwitch IsOn="{Binding OverrideElevationRequirement, Mode=TwoWay}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding OverrideElevationRequirement, Mode=TwoWay}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Override Update Version Comparison">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_6423"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <ToggleSwitch IsOn="{Binding OverrideUpdateVersionComparison, Mode=TwoWay}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding OverrideUpdateVersionComparison, Mode=TwoWay}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{Binding ForceUpdateDialogCommand}"
                    Description="Show the update dialog without requiring an actual new version"
                    Header="Force Show Update Dialog"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard Header="Override Package Convert Directory Permission Requirement">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_6955"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <ToggleSwitch IsOn="{Binding OverridePackageConvertDirectoryPermissionsRequirement, Mode=TwoWay}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding OverridePackageConvertDirectoryPermissionsRequirement, Mode=TwoWay}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Override Hard Drive Type">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                        <materialcases:SwitchPresenter
                            x:Name="GlassPresenter_7303"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </materialcases:Case.Value>
                                <ToggleSwitch
                                    IsEnabled="{x:Bind HardDriveTypeToggle.IsOn, Mode=OneWay}"
                                    IsOn="{Binding OverrideHardDriveTypeIsSolidState, Mode=TwoWay}"
                                    OffContent="HDD"
                                    OnContent="SSD"/>
                            </materialcases:Case>
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </materialcases:Case.Value>
                                <materialcontrols:LiquidGlassToggleSwitch
                                    materialtheme:ControlMaterialState.IsManaged="True"
                                    IsEnabled="{x:Bind HardDriveTypeToggle.IsOn, Mode=OneWay}"
                                    IsOn="{Binding OverrideHardDriveTypeIsSolidState, Mode=TwoWay}"
                                    OffContent="HDD"
                                    OnContent="SSD"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                        <materialcases:SwitchPresenter
                            x:Name="GlassPresenter_7611"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Visibility="{Binding Visibility, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                            Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </materialcases:Case.Value>
                                <ToggleSwitch
                                    x:Name="HardDriveTypeToggle"
                                    DataContext="{Binding DataContext, ElementName=GlassPresenter_7611, Mode=OneWay}"
                                    IsOn="{Binding OverrideHardDriveType, Mode=TwoWay}"
                                    RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_7611, Mode=OneWay}"/>
                            </materialcases:Case>
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </materialcases:Case.Value>
                                <materialcontrols:LiquidGlassToggleSwitch
                                    x:Name="HardDriveTypeToggleGlass"
                                    Width="{Binding Width, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    MinWidth="{Binding MinWidth, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    MinHeight="{Binding MinHeight, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    MaxWidth="{Binding MaxWidth, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    MaxHeight="{Binding MaxHeight, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    Padding="{Binding Padding, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    materialtheme:ControlMaterialState.IsManaged="True"
                                    materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=HardDriveTypeToggle}"
                                    BorderThickness="{Binding BorderThickness, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    FlowDirection="{Binding FlowDirection, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    FontFamily="{Binding FontFamily, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    FontSize="{Binding FontSize, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    FontStyle="{Binding FontStyle, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    FontWeight="{Binding FontWeight, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    Foreground="{Binding Foreground, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    Header="{Binding Header, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    HeaderTemplate="{Binding HeaderTemplate, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    IsEnabled="{Binding IsEnabled, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    IsOn="{Binding IsOn, ElementName=HardDriveTypeToggle, Mode=TwoWay}"
                                    OffContent="{Binding OffContent, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    OffContentTemplate="{Binding OffContentTemplate, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    OnContent="{Binding OnContent, ElementName=HardDriveTypeToggle, Mode=OneWay}"
                                    OnContentTemplate="{Binding OnContentTemplate, ElementName=HardDriveTypeToggle, Mode=OneWay}"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Always Treat As First Run After Update">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_7882"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <ToggleSwitch IsOn="{Binding AlwaysIsFirstRunAfterUpdate, Mode=TwoWay}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding AlwaysIsFirstRunAfterUpdate, Mode=TwoWay}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Alpha Build Generic API Endpoint">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                        <materialcases:SwitchPresenter
                            x:Name="GlassPresenter_8212"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Visibility="{Binding Visibility, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                            Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </materialcases:Case.Value>
                                <ToggleSwitch
                                    x:Name="GenericApiEndPointToggle"
                                    DataContext="{Binding DataContext, ElementName=GlassPresenter_8212, Mode=OneWay}"
                                    IsOn="{Binding AlphaBuildUseCNPatchEndpoint, Mode=TwoWay}"
                                    OffContent="Oversea Endpoints"
                                    OnContent="Chinese Endpoints"
                                    RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_8212, Mode=OneWay}"/>
                            </materialcases:Case>
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </materialcases:Case.Value>
                                <materialcontrols:LiquidGlassToggleSwitch
                                    x:Name="GenericApiEndPointToggleGlass"
                                    Width="{Binding Width, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    MinWidth="{Binding MinWidth, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    MinHeight="{Binding MinHeight, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    MaxWidth="{Binding MaxWidth, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    MaxHeight="{Binding MaxHeight, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    Padding="{Binding Padding, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    materialtheme:ControlMaterialState.IsManaged="True"
                                    materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GenericApiEndPointToggle}"
                                    BorderThickness="{Binding BorderThickness, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    FlowDirection="{Binding FlowDirection, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    FontFamily="{Binding FontFamily, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    FontSize="{Binding FontSize, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    FontStyle="{Binding FontStyle, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    FontWeight="{Binding FontWeight, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    Foreground="{Binding Foreground, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    Header="{Binding Header, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    HeaderTemplate="{Binding HeaderTemplate, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    IsEnabled="{Binding IsEnabled, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    IsOn="{Binding IsOn, ElementName=GenericApiEndPointToggle, Mode=TwoWay}"
                                    OffContent="{Binding OffContent, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    OffContentTemplate="{Binding OffContentTemplate, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    OnContent="{Binding OnContent, ElementName=GenericApiEndPointToggle, Mode=OneWay}"
                                    OnContentTemplate="{Binding OnContentTemplate, ElementName=GenericApiEndPointToggle, Mode=OneWay}"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                        <materialcases:SwitchPresenter
                            x:Name="GlassPresenter_8518"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </materialcases:Case.Value>
                                <ToggleSwitch
                                    IsEnabled="{x:Bind GenericApiEndPointToggle.IsOn, Mode=OneWay}"
                                    IsOn="{Binding AlphaBuildUseFJPatchEndpoint, Mode=TwoWay}"
                                    OffContent="No Secondary Endpoints"
                                    OnContent="Fujian Endpoints"/>
                            </materialcases:Case>
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </materialcases:Case.Value>
                                <materialcontrols:LiquidGlassToggleSwitch
                                    materialtheme:ControlMaterialState.IsManaged="True"
                                    IsEnabled="{x:Bind GenericApiEndPointToggle.IsOn, Mode=OneWay}"
                                    IsOn="{Binding AlphaBuildUseFJPatchEndpoint, Mode=TwoWay}"
                                    OffContent="No Secondary Endpoints"
                                    OnContent="Fujian Endpoints"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                    </StackPanel>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Hutao Cloud"/>
                <cwc:SettingsCard
                    Command="{Binding CompensationGachaLogServiceTimeCommand}"
                    Header="Compensation GachaLog Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{Binding GachaLogCompensationDays, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{Binding DesignationGachaLogServiceTimeCommand}"
                    Header="Designation GachaLog Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="UserName"/>
                        <materialcases:SwitchPresenter
                            x:Name="GlassPresenter_10360"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:TextBox"
                            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </materialcases:Case.Value>
                                <TextBox
                                    MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                    VerticalAlignment="Center"
                                    Text="{Binding GachaLogDesignationOptions.UserName, Mode=TwoWay}"/>
                            </materialcases:Case>
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </materialcases:Case.Value>
                                <materialcontrols:LiquidGlassTextBox
                                    MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                    VerticalAlignment="Center"
                                    materialtheme:ControlMaterialState.IsManaged="True"
                                    Text="{Binding GachaLogDesignationOptions.UserName, Mode=TwoWay}"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{Binding GachaLogDesignationOptions.Days, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{Binding CompensationCdnServiceTimeCommand}"
                    Header="Compensation Cdn Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{Binding CdnCompensationDays, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{Binding DesignationCdnServiceTimeCommand}"
                    Header="Designation Cdn Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="UserName"/>
                        <materialcases:SwitchPresenter
                            x:Name="GlassPresenter_12406"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:TextBox"
                            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </materialcases:Case.Value>
                                <TextBox
                                    MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                    VerticalAlignment="Center"
                                    Text="{Binding CdnDesignationOptions.UserName, Mode=TwoWay}"/>
                            </materialcases:Case>
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </materialcases:Case.Value>
                                <materialcontrols:LiquidGlassTextBox
                                    MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                    VerticalAlignment="Center"
                                    materialtheme:ControlMaterialState.IsManaged="True"
                                    Text="{Binding CdnDesignationOptions.UserName, Mode=TwoWay}"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{Binding CdnDesignationOptions.Days, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Generate Redeem Code"
                    IsExpanded="True">
                    <StackPanel Spacing="8">
                        <NumberBox
                            Header="Count"
                            PlaceholderText="Code count"
                            Text="{Binding RedeemCodeGenerateOption.Count, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialcases:SwitchPresenter
                                x:Name="GlassPresenter_13715"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
