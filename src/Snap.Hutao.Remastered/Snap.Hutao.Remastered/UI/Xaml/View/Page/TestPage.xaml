                                    Command="{Binding UploadAnnouncementCommand}"
                                    Content="Upload"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>

</shuxc:ScopedPage>
