<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwb="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lg="using:WinUI.LiquidGlass"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvs="using:Snap.Hutao.Remastered.ViewModel.Setting"
    d:DataContext="{d:DesignInstance shvs:SettingViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <shuxdc:UIGFVersionToStringConverter x:Key="UIGFVersionToStringConverter"/>
    </Page.Resources>

    <Grid x:Name="SettingPageGrid">
        <ScrollViewer x:Name="RootScrollViewer" Style="{StaticResource TwoPanelScrollViewerStyle}">
            <shuxc:ScrollViewerHelper.RightPanel>
                <Border
                    x:Name="ScrollViewerRightPanel"
                    Width="400"
                    Margin="0,16,16,16"
                    VerticalAlignment="Top"
                    cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
                    Visibility="Collapsed">
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="16" Spacing="{ThemeResource SettingsCardSpacing}">

                                <Grid Style="{ThemeResource GridCardStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Image
                                        Grid.Row="0"
                                        MaxWidth="120"
                                        MaxHeight="120"
                                        Margin="48,48"
                                        Source="ms-appx:///Assets/InAppLogo.png"/>
                                    <cwc:UniformGrid
                                        Grid.Row="1"
                                        Margin="16"
                                        VerticalAlignment="Bottom"
                                        ColumnSpacing="8"
                                        Columns="2"
                                        RowSpacing="8">
                                        <materialcases:SwitchPresenter
                                            x:Name="GlassPresenter_3381"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:HyperlinkButton"
                                            Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </materialcases:Case.Value>
                                                <HyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Home}"/>
                                            </materialcases:Case>
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </materialcases:Case.Value>
                                                <materialcontrols:LiquidGlassHyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    materialtheme:ControlMaterialState.IsManaged="True"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Home}"/>
                                            </materialcases:Case>
                                        </materialcases:SwitchPresenter>
                                        <materialcases:SwitchPresenter
                                            x:Name="GlassPresenter_3803"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:HyperlinkButton"
                                            Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </materialcases:Case.Value>
                                                <HyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                            </materialcases:Case>
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </materialcases:Case.Value>
                                                <materialcontrols:LiquidGlassHyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    materialtheme:ControlMaterialState.IsManaged="True"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                            </materialcases:Case>
                                        </materialcases:SwitchPresenter>
                                        <materialcases:SwitchPresenter
                                            x:Name="GlassPresenter_4226"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:HyperlinkButton"
                                            Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </materialcases:Case.Value>
                                                <HyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                            </materialcases:Case>
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </materialcases:Case.Value>
                                                <materialcontrols:LiquidGlassHyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    materialtheme:ControlMaterialState.IsManaged="True"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                            </materialcases:Case>
                                        </materialcases:SwitchPresenter>
                                    </cwc:UniformGrid>
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Copyright © 2022 - 2025 DGP Studio. All Rights Reserved."/>
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Copyright © 2026 SnapHutaoRemasteringProject. All Rights Reserved."
                                        TextWrapping="NoWrap"/>
                                </Grid>

                                <!--  应用行为 - 宽屏  -->
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingAppBehaviorHeader}"/>

                                <cwc:SettingsCard
                                    Command="{Binding CheckUpdateCommand}"
                                    Description="{Binding UpdateInfo}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCheckUpdateHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    IsClickEnabled="True"/>

                                <!--  Administor  -->
                                <cwc:SettingsExpander HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}" IsExpanded="True">
                                    <cwc:SettingsExpander.Header>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPageSettingElevatedModeHeader}"/>
                                    </cwc:SettingsExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialcases:SwitchPresenter
                                            x:Name="GlassPresenter_6918"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:Button"
                                            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </materialcases:Case.Value>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding RestartAsElevatedCommand}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </materialcases:Case>
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </materialcases:Case.Value>
                                                <materialcontrols:LiquidGlassButton
                                                    HorizontalAlignment="Right"
                                                    materialtheme:ControlMaterialState.IsManaged="True"
                                                    Command="{Binding RestartAsElevatedCommand}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </materialcases:Case>
                                        </materialcases:SwitchPresenter>
                                    </StackPanel>
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard Description="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminDescription}" Header="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminHeader}">
                                            <materialcases:SwitchPresenter
                                                x:Name="GlassPresenter_7679"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleSwitch"
                                                Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <ToggleSwitch IsOn="{Binding AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                            </materialcases:SwitchPresenter>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <!--  Auto start  -->
                                <cwc:SettingsExpander
                                    Description="{shuxm:ResourceString Name=ViewPageSettingAutoStartDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE7E8;}"
                                    IsEnabled="{shuxm:IsProcessElevated}">
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartEnableCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EE;}"
                                            IsClickEnabled="False">
                                            <materialcases:SwitchPresenter
                                                x:Name="GlassPresenter_8862"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleSwitch"
                                                Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <ToggleSwitch IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                            </materialcases:SwitchPresenter>
                                        </cwc:SettingsCard>

                                        <!--  Will keep enable if AutoRestartAsAdmin is enabled, because it will start as admin when startup and avoid UAC prompt and keep consistent with the behavior  -->
                                        <cwc:SettingsCard
                                            Description="{shuxm:ResourceString Name=ViewPageSettingAutoStartAdminActionCardDescription}"
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartAdminActionCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}"
                                            IsClickEnabled="False"
                                            IsEnabled="{Binding IsStartupAsAdminCardEnabled, Mode=OneWay}">
                                            <materialcases:SwitchPresenter
                                                x:Name="GlassPresenter_9821"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleSwitch"
                                                Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <ToggleSwitch IsOn="{Binding IsStartupAsAdminEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding IsStartupAsAdminEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                            </materialcases:SwitchPresenter>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{Binding CreateDesktopShortcutCommand}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>
                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{Binding CreateGameLaunchShortcutCommand}"
                                    Header="{shuxm:ResourceString Name=ViewPageLaunchGameCreateGameLaunchShortcut}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>

                                <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}" IsClickEnabled="False">
                                    <materialcases:SwitchPresenter
                                        x:Name="GlassPresenter_11300"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        IsTabStop="False"
                                        Tag="LiquidGlass:HyperlinkButton"
                                        Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                        <materialcases:Case>
                                            <materialcases:Case.Value>
                                                <x:Int32>0</x:Int32>
                                            </materialcases:Case.Value>
                                            <HyperlinkButton Content="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}" NavigateUri="https://mirrorchyan.com?source=snap_hutao_app_settings"/>
                                        </materialcases:Case>
                                        <materialcases:Case>
                                            <materialcases:Case.Value>
                                                <x:Int32>1</x:Int32>
                                            </materialcases:Case.Value>
                                            <materialcontrols:LiquidGlassHyperlinkButton
                                                materialtheme:ControlMaterialState.IsManaged="True"
                                                Content="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}"
                                                NavigateUri="https://mirrorchyan.com?source=snap_hutao_app_settings"/>
                                        </materialcases:Case>
                                    </materialcases:SwitchPresenter>
                                </cwc:SettingsCard>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </shuxc:ScrollViewerHelper.RightPanel>
            <Grid HorizontalAlignment="Stretch">
                <StackPanel
                    Grid.Column="0"
                    Padding="16"
                    Spacing="16">

                    <!--  关于  -->
                    <Border x:Name="ScrollViewerTopPanel" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Visibility="Visible">
                                <Grid MaxHeight="176" Style="{ThemeResource GridCardStyle}">
                                    <Grid Padding="48,28,48,28" ColumnSpacing="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            MaxWidth="120"
                                            MaxHeight="120"
                                            Source="ms-appx:///Assets/InAppLogo.png"/>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            VerticalAlignment="Center">
                                            <cwc:UniformGrid
                                                VerticalAlignment="Center"
                                                ColumnSpacing="8"
                                                Columns="2"
                                                RowSpacing="8">
                                                <materialcases:SwitchPresenter
                                                    x:Name="GlassPresenter_13665"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"
                                                    Tag="LiquidGlass:HyperlinkButton"
                                                    Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                    <materialcases:Case>
                                                        <materialcases:Case.Value>
                                                            <x:Int32>0</x:Int32>
                                                        </materialcases:Case.Value>
                                                        <HyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Home}"/>
                                                    </materialcases:Case>
                                                    <materialcases:Case>
                                                        <materialcases:Case.Value>
                                                            <x:Int32>1</x:Int32>
                                                        </materialcases:Case.Value>
                                                        <materialcontrols:LiquidGlassHyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            materialtheme:ControlMaterialState.IsManaged="True"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Home}"/>
                                                    </materialcases:Case>
                                                </materialcases:SwitchPresenter>
                                                <materialcases:SwitchPresenter
                                                    x:Name="GlassPresenter_14127"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"
                                                    Tag="LiquidGlass:HyperlinkButton"
                                                    Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                    <materialcases:Case>
                                                        <materialcases:Case.Value>
                                                            <x:Int32>0</x:Int32>
                                                        </materialcases:Case.Value>
                                                        <HyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                                    </materialcases:Case>
                                                    <materialcases:Case>
                                                        <materialcases:Case.Value>
                                                            <x:Int32>1</x:Int32>
                                                        </materialcases:Case.Value>
                                                        <materialcontrols:LiquidGlassHyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            materialtheme:ControlMaterialState.IsManaged="True"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                                    </materialcases:Case>
                                                </materialcases:SwitchPresenter>
                                                <materialcases:SwitchPresenter
                                                    x:Name="GlassPresenter_14590"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"
                                                    Tag="LiquidGlass:HyperlinkButton"
                                                    Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                    <materialcases:Case>
                                                        <materialcases:Case.Value>
                                                            <x:Int32>0</x:Int32>
                                                        </materialcases:Case.Value>
                                                        <HyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                                    </materialcases:Case>
                                                    <materialcases:Case>
                                                        <materialcases:Case.Value>
                                                            <x:Int32>1</x:Int32>
                                                        </materialcases:Case.Value>
                                                        <materialcontrols:LiquidGlassHyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            materialtheme:ControlMaterialState.IsManaged="True"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                                    </materialcases:Case>
                                                </materialcases:SwitchPresenter>
                                            </cwc:UniformGrid>
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                Opacity="0.7"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Copyright © 2022 - 2025 DGP Studio. All Rights Reserved."/>
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                Opacity="0.7"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Copyright © 2026 SnapHutaoRemasteringProject. All Rights Reserved."/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!--  应用行为 - 窄屏  -->
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingAppBehaviorHeader}"/>

                                <cwc:SettingsCard
                                    Command="{Binding CheckUpdateCommand}"
                                    Description="{Binding UpdateInfo}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCheckUpdateHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    IsClickEnabled="True"/>

                                <!--  Administor  -->
                                <cwc:SettingsExpander HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}" IsExpanded="True">
                                    <cwc:SettingsExpander.Header>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPageSettingElevatedModeHeader}"/>
                                    </cwc:SettingsExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialcases:SwitchPresenter
                                            x:Name="GlassPresenter_17208"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:Button"
                                            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </materialcases:Case.Value>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding RestartAsElevatedCommand}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </materialcases:Case>
                                            <materialcases:Case>
                                                <materialcases:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </materialcases:Case.Value>
                                                <materialcontrols:LiquidGlassButton
                                                    HorizontalAlignment="Right"
                                                    materialtheme:ControlMaterialState.IsManaged="True"
                                                    Command="{Binding RestartAsElevatedCommand}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </materialcases:Case>
                                        </materialcases:SwitchPresenter>
                                    </StackPanel>
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard Description="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminDescription}" Header="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminHeader}">
                                            <materialcases:SwitchPresenter
                                                x:Name="GlassPresenter_17969"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleSwitch"
                                                Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <ToggleSwitch IsOn="{Binding AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                                <materialcases:Case>
                                                    <materialcases:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </materialcases:Case.Value>
                                                    <materialcontrols:LiquidGlassToggleSwitch materialtheme:ControlMaterialState.IsManaged="True" IsOn="{Binding AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                                </materialcases:Case>
                                            </materialcases:SwitchPresenter>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <!--  Auto start  -->
                                <cwc:SettingsExpander
