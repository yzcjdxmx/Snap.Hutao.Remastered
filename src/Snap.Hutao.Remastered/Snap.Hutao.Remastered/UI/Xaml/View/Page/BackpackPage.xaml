<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.BackpackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcas="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSortBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shv="using:Snap.Hutao.Remastered.ViewModel.Backpack"
    d:DataContext="{d:DesignInstance shv:BackpackViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFD0093"
                        Minimum="#FF4B00D9"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="ScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="50"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFF69BF"
                        Minimum="#FF9F69FF"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="ScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="50"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Flyout x:Key="ItemDetailFlyout">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <shuxc:ItemFlyoutContent/>
            </Flyout>

            <!--  Weapon card  -->
            <DataTemplate x:Key="WeaponCardTemplate" x:DataType="shv:BackpackWeaponItemView">
                <shuxcc:HorizontalCard Width="270">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Tapped">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="ItemDetailFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <shuxcc:HorizontalCard.Left>
                        <shuxc:ItemIcon
                            Width="54"
                            Height="54"
                            Margin="4,0"
                            Icon="{Binding Weapon.Icon, Converter={StaticResource EquipIconConverter}}"
                            Quality="{Binding Weapon.RankLevel}"/>
                    </shuxcc:HorizontalCard.Left>
                    <shuxcc:HorizontalCard.Right>
                        <Grid Margin="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="{Binding Weapon.Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding WeaponTypeName}"/>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding LevelRefinementInfo}"/>
                            </StackPanel>
                            <shuxc:LockIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,-10,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsLocked="{Binding IsLocked}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Right>
                </shuxcc:HorizontalCard>
            </DataTemplate>

            <DataTemplate x:Key="ReliquaryCardTemplate" x:DataType="shv:BackpackReliquaryItemView">
                <Border Width="320" Style="{StaticResource BorderShimmerStyle}">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Tapped">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="ItemDetailFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <shuxc:LockIcon
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsLocked="{Binding IsLocked}"/>
                            <shuxc:MarkIcon
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsMarked="{Binding IsMarked}"/>
                        </Grid>

                        <Grid
                            Grid.Row="0"
                            Padding="12"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Grid.Column="0"
                                Width="54"
                                Height="54"
                                Icon="{Binding Reliquary.Icon, Converter={StaticResource ItemIconConverter}}"
                                Quality="{Binding Reliquary.RankLevel}"/>
                            <Grid Grid.Column="1">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Reliquary.Name}"/>
                                    <TextBlock
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding SetName}"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontWeight="Bold"
                                        Style="{StaticResource BaseTextBlockStyle}">
                                        <Run Text="+"/>
                                        <Run Text="{Binding Level}"/>
                                    </TextBlock>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding DisplayScore}"
                                        Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding ScoreColorValue, Converter={ThemeResource ScoreToColorConverter}}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                        <Grid Grid.Row="2" Padding="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{Binding MainPropName}"/>
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{Binding MainPropValue}"/>
                        </Grid>

                        <Rectangle
                            Grid.Row="3"
                            Height="1"
                            Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                        <ItemsControl
                            Grid.Row="4"
                            Margin="0,12"
                            ItemTemplate="{StaticResource BackpackReliquarySubStatTemplate}"
                            ItemsSource="{Binding PaddedSubStats}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="BackpackReliquarySubStatTemplate" x:DataType="shv:BackpackReliquarySubStatView">
                <Grid
                    MinHeight="20"
                    Padding="12,0"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{Binding DisplayName}"
                        TextWrapping="NoWrap"
                        Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding DisplayValue}"
                        Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Grid Grid.Column="2" Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Opacity="0.8"
                            StrokeThickness="1">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}}"/>
                            </Ellipse.Stroke>
                        </Ellipse>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{ThemeResource InfoBadgeValueFontSize}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding EnhancedCount}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!--  Default card  -->
            <DataTemplate x:Key="DefaultCardTemplate" x:DataType="shv:BackpackItemView">
                <shuxcc:HorizontalCard Width="270">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Tapped">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="ItemDetailFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <shuxcc:HorizontalCard.Left>
                        <shuxc:ItemIcon
                            Width="40"
                            Height="40"
                            Icon="{Binding Material.Icon, Converter={StaticResource ItemIconConverter}}"
                            Quality="{Binding Material.RankLevel}"/>
                    </shuxcc:HorizontalCard.Left>
                    <shuxcc:HorizontalCard.Right>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Material.Name}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding DisplayCount}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Right>
                </shuxcc:HorizontalCard>
            </DataTemplate>

            <shv:BackpackItemTemplateSelector
                x:Key="BackpackItemTemplateSelector"
                DefaultTemplate="{StaticResource DefaultCardTemplate}"
                ReliquaryTemplate="{StaticResource ReliquaryCardTemplate}"
                WeaponTemplate="{StaticResource WeaponCardTemplate}"/>

            <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
                <Grid Height="22" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--  IconUri  -->
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-4,0,0,0"
                        HorizontalAlignment="Left"
                        ShowAsMonoChrome="True"
                        Source="{Binding IconUri, Mode=OneWay}"
                        Visibility="{Binding IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                    <!--  Quality dot  -->
                    <Ellipse
                        Grid.Column="0"
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        Visibility="{Binding Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding Quality}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Grid Grid.Column="0">
                        <!--  SideIconUri  -->
                        <shuxci:CachedImage
                            Width="20"
                            Height="20"
                            Margin="-4,0,0,0"
                            HorizontalAlignment="Left"
                            Source="{Binding SideIconUri, Mode=OneWay}"
                            Visibility="{Binding SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}}"/>
                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Text="{Binding Value}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <shuxc:StandardView HideCondition="{Binding IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" ShowCondition="{Binding Archives.CurrentItem, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border
                    MinWidth="480"
                    Padding="16"
                    Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel>
                        <Image
                            Width="120"
                            Height="120"
                            Source="ms-appx:///Resource/Navigation/Backpack.png"/>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageBackpackAddArchiveHint}"/>
                        <materialcases:SwitchPresenter
                            x:Name="GlassPresenter_20193"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </materialcases:Case.Value>
                                <Button
                                    Padding="16,8"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AddArchiveCommand}"
                                    Content="{shuxm:ResourceString Name=ViewPageBackpackAddArchive}"/>
                            </materialcases:Case>
                            <materialcases:Case>
                                <materialcases:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </materialcases:Case.Value>
                                <materialcontrols:LiquidGlassButton
                                    Padding="16,8"
                                    HorizontalAlignment="Stretch"
                                    materialtheme:ControlMaterialState.IsManaged="True"
                                    Command="{Binding AddArchiveCommand}"
                                    Content="{shuxm:ResourceString Name=ViewPageBackpackAddArchive}"/>
                            </materialcases:Case>
                        </materialcases:SwitchPresenter>
                    </StackPanel>
                </Border>
            </Border>
        </shuxc:StandardView.EmptyContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--  Filter bar  -->
            <Border
                Grid.Row="0"
                Margin="16"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                    <Grid Margin="4,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <shuxca:AutoSuggestTokenBox
                            Width="800"
                            Height="44"
                            Margin="6,-2,6,6"
                            HorizontalAlignment="Right"
                            AvailableTokens="{Binding SearchData.AvailableTokens}"
                            FilterCommand="{Binding FilterCommand}"
                            ItemsSource="{Binding SearchData.FilterTokens, Mode=TwoWay}"
                            MaximumTokens="5"
                            PlaceholderText="{shuxm:ResourceString Name=ViewPageBackpackFilterPlaceholder}"
                            QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                            Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                            SuggestedItemTemplate="{StaticResource TokenTemplate}"
                            SuggestedItemsSource="{Binding SearchData.AvailableTokens.Values}"
                            Text="{Binding SearchData.FilterToken, Mode=TwoWay}"
                            TokenItemTemplate="{StaticResource TokenTemplate}"/>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <materialcases:SwitchPresenter
                                x:Name="GlassPresenter_22704"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                <materialcases:Case>
                                    <materialcases:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </materialcases:Case.Value>
                                    <Button VerticalAlignment="Center">
                                        <Button.Flyout>
                                            <Flyout>
                                                <shuxcas:AutoSortList
                                                    Width="260"
                                                    AvailableTokens="{Binding AvailableSortTokens}"
                                                    SortCommand="{Binding ApplySortCommand}"/>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="12" Glyph="&#xE8CB;"/>
                                            <TextBlock Text="{shuxm:ResourceString Name=ViewPageBackpackSortHeader}"/>
                                        </StackPanel>
                                    </Button>
                                </materialcases:Case>
                                <materialcases:Case>
                                    <materialcases:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </materialcases:Case.Value>
                                    <materialcontrols:LiquidGlassButton VerticalAlignment="Center" materialtheme:ControlMaterialState.IsManaged="True">
                                        <materialcontrols:LiquidGlassButton.Flyout>
                                            <Flyout>
                                                <shuxcas:AutoSortList
                                                    Width="260"
                                                    AvailableTokens="{Binding AvailableSortTokens}"
                                                    SortCommand="{Binding ApplySortCommand}"/>
                                            </Flyout>
                                        </materialcontrols:LiquidGlassButton.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="12" Glyph="&#xE8CB;"/>
                                            <TextBlock Text="{shuxm:ResourceString Name=ViewPageBackpackSortHeader}"/>
                                        </StackPanel>
                                    </materialcontrols:LiquidGlassButton>
                                </materialcases:Case>
                            </materialcases:SwitchPresenter>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <Pivot
                Grid.Row="1"
                Margin="0,-24"
                SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                Style="{ThemeResource CardPivotStyle}">
                <Pivot.RightHeader>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarElementContainer AllowFocusOnInteraction="True">
                            <shuxc:SizeRestrictedContentControl Margin="2,6,3,6">
                                <materialcases:SwitchPresenter
                                    x:Name="GlassPresenter_24224"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    IsTabStop="False"
                                    Tag="LiquidGlass:ComboBox"
                                    Visibility="{Binding Visibility, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                    Value="{Binding ComboBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                    <materialcases:Case>
                                        <materialcases:Case.Value>
                                            <x:Int32>0</x:Int32>
                                        </materialcases:Case.Value>
                                        <ComboBox
                                            x:Name="GlassPresenter_24224_State"
                                            DataContext="{Binding DataContext, ElementName=GlassPresenter_24224, Mode=OneWay}"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding Archives}"
                                            RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_24224, Mode=OneWay}"
                                            SelectedItem="{Binding Archives.CurrentItem, Mode=TwoWay}"
                                            Style="{ThemeResource CommandBarComboBoxStyle}"/>
                                    </materialcases:Case>
                                    <materialcases:Case>
                                        <materialcases:Case.Value>
                                            <x:Int32>1</x:Int32>
                                        </materialcases:Case.Value>
                                        <materialcontrols:LiquidGlassComboBox
                                            x:Name="GlassPresenter_24224_StateGlass"
                                            Width="{Binding Width, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            Height="{Binding Height, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            MinWidth="{Binding MinWidth, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            MinHeight="{Binding MinHeight, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            MaxWidth="{Binding MaxWidth, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            MaxHeight="{Binding MaxHeight, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            Padding="{Binding Padding, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            materialtheme:ControlMaterialState.IsManaged="True"
                                            materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassPresenter_24224_State}"
                                            BorderThickness="{Binding BorderThickness, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            DisplayMemberPath="{Binding DisplayMemberPath, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            FlowDirection="{Binding FlowDirection, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            FontFamily="{Binding FontFamily, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            FontSize="{Binding FontSize, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            FontStyle="{Binding FontStyle, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            FontWeight="{Binding FontWeight, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            Foreground="{Binding Foreground, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            Header="{Binding Header, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            HeaderTemplate="{Binding HeaderTemplate, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            IsDropDownOpen="{Binding IsDropDownOpen, ElementName=GlassPresenter_24224_State, Mode=TwoWay}"
                                            IsEditable="{Binding IsEditable, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            IsEnabled="{Binding IsEnabled, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            IsTextSearchEnabled="{Binding IsTextSearchEnabled, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            ItemsSource="{Binding ItemsSource, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            MaxDropDownHeight="{Binding MaxDropDownHeight, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            PlaceholderText="{Binding PlaceholderText, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            SelectedIndex="{Binding SelectedIndex, ElementName=GlassPresenter_24224_State, Mode=TwoWay}"
                                            SelectedValuePath="{Binding SelectedValuePath, ElementName=GlassPresenter_24224_State, Mode=OneWay}"
                                            Style="{ThemeResource CommandBarComboBoxStyle}"/>
                                    </materialcases:Case>
                                </materialcases:SwitchPresenter>
                            </shuxc:SizeRestrictedContentControl>
                        </AppBarElementContainer>
                        <AppBarButton
                            Command="{Binding AddArchiveCommand}"
                            Icon="{shuxm:FontIcon Glyph=&#xE710;}"
                            Label="{shuxm:ResourceString Name=ViewPageBackpackAddArchive}"/>
                        <AppBarButton
                            Command="{Binding RemoveArchiveCommand}"
                            Icon="{shuxm:FontIcon Glyph=&#xE74D;}"
                            Label="{shuxm:ResourceString Name=ViewPageBackpackRemoveArchive}"/>
                        <AppBarSeparator/>
                        <AppBarButton
                            Command="{Binding RefreshByEmbeddedYaeCommand}"
                            Icon="{shuxm:FontIcon Glyph=&#xE72C;}"
                            Label="{shuxm:ResourceString Name=ViewPageBackpackRefreshByEmbeddedYae}"/>
                        <AppBarSeparator/>
                        <AppBarButton
                            Command="{Binding ConfigureScoreCommand}"
                            Icon="{shuxm:FontIcon Glyph=&#xE946;}"
                            Label="{shuxm:ResourceString Name=ViewPageBackpackConfigureScore}"/>
                    </CommandBar>
                </Pivot.RightHeader>

                <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryWeapon}">
                    <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <GridView
                                Padding="16,16,10,10"
                                ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                                ItemsSource="{Binding Items}"
                                SelectionMode="None">
                                <GridView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,0,6,6"/>
                                    </Style>
                                </GridView.ItemContainerStyle>
                            </GridView>
                        </Border>
                    </Border>
                </PivotItem>
                <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryReliquary}">
                    <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <GridView
                                Padding="16,16,10,10"
                                ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                                ItemsSource="{Binding Items}"
                                SelectionMode="None">
                                <GridView.ItemContainerStyle>
