<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.CultivateProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogCultivateProjectTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_815"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <TextBox
                    VerticalAlignment="Top"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCultivateProjectInputPlaceholder}"
                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassTextBox
                    VerticalAlignment="Top"
                    materialtheme:ControlMaterialState.IsManaged="True"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogCultivateProjectInputPlaceholder}"
                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>

        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_1055"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:ComboBox"
            Visibility="{Binding Visibility, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
            Value="{Binding ComboBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <ComboBox
                    x:Name="GlassPresenter_1055_State"
                    HorizontalAlignment="Stretch"
                    DataContext="{Binding DataContext, ElementName=GlassPresenter_1055, Mode=OneWay}"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ServerTimeZoneOffsets}"
                    RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1055, Mode=OneWay}"
                    SelectedItem="{x:Bind SelectedServerTimeZoneOffset, Mode=TwoWay}"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassComboBox
                    x:Name="GlassPresenter_1055_StateGlass"
                    Width="{Binding Width, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    Height="{Binding Height, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    MinWidth="{Binding MinWidth, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    MinHeight="{Binding MinHeight, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    MaxWidth="{Binding MaxWidth, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    MaxHeight="{Binding MaxHeight, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    Padding="{Binding Padding, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    materialtheme:ControlMaterialState.IsManaged="True"
                    materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassPresenter_1055_State}"
                    BorderThickness="{Binding BorderThickness, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    DisplayMemberPath="{Binding DisplayMemberPath, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    FlowDirection="{Binding FlowDirection, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    FontFamily="{Binding FontFamily, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    FontSize="{Binding FontSize, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    FontStyle="{Binding FontStyle, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    FontWeight="{Binding FontWeight, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    Foreground="{Binding Foreground, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    Header="{Binding Header, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    HeaderTemplate="{Binding HeaderTemplate, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    IsDropDownOpen="{Binding IsDropDownOpen, ElementName=GlassPresenter_1055_State, Mode=TwoWay}"
                    IsEditable="{Binding IsEditable, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    IsEnabled="{Binding IsEnabled, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    IsTextSearchEnabled="{Binding IsTextSearchEnabled, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    ItemsSource="{Binding ItemsSource, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    MaxDropDownHeight="{Binding MaxDropDownHeight, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    PlaceholderText="{Binding PlaceholderText, ElementName=GlassPresenter_1055_State, Mode=OneWay}"
                    SelectedIndex="{Binding SelectedIndex, ElementName=GlassPresenter_1055_State, Mode=TwoWay}"
                    SelectedValuePath="{Binding SelectedValuePath, ElementName=GlassPresenter_1055_State, Mode=OneWay}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
    </StackPanel>
</ContentDialog>
