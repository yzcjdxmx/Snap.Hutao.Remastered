<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.MirrorChyanCdkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogMirrorChyanCdkTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap">
            <TextBlock.Inlines>
                <Run Text="{shuxm:ResourceString Name=ViewDialogMirrorChyanCdkHint}"/>
                <Hyperlink NavigateUri="https://mirrorchyan.com/zh/projects?rid=SnapHutaoRemastered">
                    <Run Text="{shuxm:ResourceString Name=ViewDialogMirrorChyanCdkGetCdk}"/>
                </Hyperlink>
            </TextBlock.Inlines>
        </TextBlock>
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_1318"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <TextBox Text="{x:Bind Text, Mode=TwoWay}"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassTextBox materialtheme:ControlMaterialState.IsManaged="True" Text="{x:Bind Text, Mode=TwoWay}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
    </StackPanel>
</ContentDialog>
