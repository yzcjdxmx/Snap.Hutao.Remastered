<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.UserAccountVerificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogUserAccountVerificationTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsLoginEnabled, Mode=OneWay}"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <TextBlock Text="{x:Bind Email, Mode=OneWay}"/>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1149"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:TextBox"
                Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <TextBox
                        CornerRadius="0,4,4,0"
                        KeyDown="OnTextKeyDown"
                        KeyUp="OnTextKeyUp"
                        PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountVerificationCaptchaPlaceholder}"
                        Text="{x:Bind Captcha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassTextBox
                        materialtheme:ControlMaterialState.IsManaged="True"
                        CornerRadius="0,4,4,0"
                        KeyDown="OnTextKeyDown"
                        KeyUp="OnTextKeyUp"
                        PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountVerificationCaptchaPlaceholder}"
                        Text="{x:Bind Captcha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1491"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Button Command="{x:Bind SendEmailCaptchaCommand}" Content="{shuxm:ResourceString Name=ViewDialogUserMobileCaptchaSendCaptchaAction}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassButton
                        materialtheme:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind SendEmailCaptchaCommand}"
                        Content="{shuxm:ResourceString Name=ViewDialogUserMobileCaptchaSendCaptchaAction}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
        </Grid>
    </StackPanel>
</ContentDialog>
