<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.CultivatePromotionDeltaBatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaBatchTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="NumberBoxMinWidth">180</x:Double>

        <x:Double x:Key="SettingsCardSpacing">3</x:Double>
        <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchAvatarLevelTarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="90"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.AvatarLevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchSkillATarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="10"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.SkillList[0].LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchSkillETarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="10"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.SkillList[1].LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchSkillQTarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="10"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.SkillList[2].LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchWeaponLevelTarget}">
            <!--  ReSharper disable once Xaml.PossibleNullReferenceException  -->
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="90"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.Weapon.LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>

        <RadioButtons
            x:Name="SaveModeSelector"
            Margin="0,13,0,0"
            Header="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyHeader}"
            SelectedIndex="0">
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_3863"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_3863, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_3863"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyPreserveExisting}"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_3863, Mode=OneWay}"
                        GroupName="GlassRadioGroup_3638"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_3863, Mode=OneWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_3863Glass"
                        Width="{Binding Width, ElementName=GlassNative_3863, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_3863, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_3863, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_3863, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_3863, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_3863, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_3863, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_3863}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_3863, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_3863, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_3863, Mode=OneWay}"
                        Content="{Binding Content, ElementName=GlassNative_3863, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_3863, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_3863, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_3863, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_3863, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_3863, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_3863, Mode=OneWay}"
                        GroupName="GlassRadioGroup_3638Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_3863, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_3863, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_3989"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_3989, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_3989"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyOverwriteExisting}"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_3989, Mode=OneWay}"
                        GroupName="GlassRadioGroup_3638"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_3989, Mode=OneWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_3989Glass"
                        Width="{Binding Width, ElementName=GlassNative_3989, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_3989, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_3989, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_3989, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_3989, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_3989, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_3989, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_3989}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_3989, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_3989, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_3989, Mode=OneWay}"
                        Content="{Binding Content, ElementName=GlassNative_3989, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_3989, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_3989, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_3989, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_3989, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_3989, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_3989, Mode=OneWay}"
                        GroupName="GlassRadioGroup_3638Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_3989, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_3989, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_4116"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_4116, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_4116"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyCreateNewEntry}"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_4116, Mode=OneWay}"
                        GroupName="GlassRadioGroup_3638"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_4116, Mode=OneWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_4116Glass"
                        Width="{Binding Width, ElementName=GlassNative_4116, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_4116, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_4116, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_4116, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_4116, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_4116, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_4116, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_4116}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_4116, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_4116, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_4116, Mode=OneWay}"
                        Content="{Binding Content, ElementName=GlassNative_4116, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_4116, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_4116, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_4116, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_4116, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_4116, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_4116, Mode=OneWay}"
                        GroupName="GlassRadioGroup_3638Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_4116, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_4116, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
        </RadioButtons>
    </StackPanel>
</ContentDialog>
