<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.ReconfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxct="using:Snap.Hutao.Remastered.UI.Xaml.Control.TextBlock"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogReconfirmTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Message="{shuxm:ResourceString Name=ViewDialogReconfirmHint}"
            Severity="Error"/>
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_1086"
            Margin="0,0,0,8"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <TextBox
                    VerticalAlignment="Top"
                    Opacity="0.15"
                    Style="{StaticResource DefaultTextBoxStyle}"
                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.HeaderTemplate>
                        <DataTemplate>
                            <shuxct:HtmlDescriptionTextBlock Description="{shuxm:ResourceString Name=ViewDialogReconfirmTextHeader}"/>
                        </DataTemplate>
                    </TextBox.HeaderTemplate>
                </TextBox>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassTextBox
                    VerticalAlignment="Top"
                    materialtheme:ControlMaterialState.IsManaged="True"
                    Opacity="0.15"
                    Style="{StaticResource DefaultTextBoxStyle}"
                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <materialcontrols:LiquidGlassTextBox.HeaderTemplate>
                        <DataTemplate>
                            <shuxct:HtmlDescriptionTextBlock Description="{shuxm:ResourceString Name=ViewDialogReconfirmTextHeader}"/>
                        </DataTemplate>
                    </materialcontrols:LiquidGlassTextBox.HeaderTemplate>
                </materialcontrols:LiquidGlassTextBox>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
    </StackPanel>
</ContentDialog>
