<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.HutaoPassportRegisterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogHutaoPassportRegisterTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsAgreed.Value, Mode=OneWay, FallbackValue=False}"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Margin="0,8,0,0" Spacing="16">
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_929"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <TextBox
                    InputScope="EmailSmtpAddress"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportUserNameHint}"
                    Text="{x:Bind UserName, Mode=TwoWay}"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassTextBox
                    materialtheme:ControlMaterialState.IsManaged="True"
                    InputScope="EmailSmtpAddress"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportUserNameHint}"
                    Text="{x:Bind UserName, Mode=TwoWay}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1370"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:TextBox"
                Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <TextBox PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeHint}" Text="{x:Bind VerifyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassTextBox
                        materialtheme:ControlMaterialState.IsManaged="True"
                        PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeHint}"
                        Text="{x:Bind VerifyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1616"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Button
                        VerticalAlignment="Stretch"
                        Command="{x:Bind VerifyCommand}"
                        Content="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeAction}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassButton
                        VerticalAlignment="Stretch"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind VerifyCommand}"
                        Content="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeAction}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
        </Grid>
        <StackPanel Spacing="4" Visibility="{x:Bind VerifyCode, Converter={StaticResource EmptyStringToVisibilityConverter}, Mode=OneWay}">
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_2011"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:PasswordBox"
                Visibility="{Binding Visibility, ElementName=GlassNative_2011, Mode=OneWay}"
                Value="{Binding PasswordBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <PasswordBox
                        x:Name="GlassNative_2011"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_2011, Mode=OneWay}"
                        IsEnabled="{x:Bind VerifyCode, Converter={StaticResource EmptyStringToBoolConverter}, Mode=OneWay}"
                        Password="{x:Bind Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PasswordChar="*"
                        PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportPasswordHint}"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_2011, Mode=OneWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassPasswordBox
                        x:Name="GlassNative_2011Glass"
                        Width="{Binding Width, ElementName=GlassNative_2011, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_2011, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_2011, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_2011, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_2011, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_2011, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_2011, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_2011}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_2011, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_2011, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_2011, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_2011, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_2011, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_2011, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_2011, Mode=OneWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_2011, Mode=OneWay}"
                        Password="{Binding Password, ElementName=GlassNative_2011, Mode=TwoWay}"
                        PlaceholderText="{Binding PlaceholderText, ElementName=GlassNative_2011, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <TextBlock
                Opacity="0.7"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportPasswordRequirementHint}"/>
        </StackPanel>
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_2610"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:CheckBox"
            Value="{Binding CheckBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <CheckBox IsChecked="{x:Bind IsAgreed, Mode=TwoWay}">
                    <TextBlock Text="{shuxm:ResourceString Name=ViewPageHutaoPassportRegisterAgreement}"/>
                </CheckBox>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassCheckBox materialtheme:ControlMaterialState.IsManaged="True" IsChecked="{x:Bind IsAgreed, Mode=TwoWay}">
                    <TextBlock Text="{shuxm:ResourceString Name=ViewPageHutaoPassportRegisterAgreement}"/>
                </materialcontrols:LiquidGlassCheckBox>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
    </StackPanel>
</ContentDialog>
