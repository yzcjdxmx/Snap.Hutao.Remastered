<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.CultivatePromotionDeltaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="NumberBoxMinWidth">180</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>

        <DataTemplate x:Key="SkillTemplate">
            <Border Margin="0,2,0,0" Style="{StaticResource BorderCardStyle}">
                <Grid Margin="8" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        ShowAsMonoChrome="True"
                        Source="{Binding Icon}"/>
                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"/>
                    <NumberBox
                        Grid.Column="3"
                        MinWidth="{StaticResource NumberBoxMinWidth}"
                        VerticalAlignment="Center"
                        Maximum="{Binding LevelMax}"
                        Minimum="{Binding LevelMin}"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                    <FontIcon
                        Grid.Column="4"
                        Margin="8"
                        FontSize="12"
                        Glyph="&#xEBE7;"/>
                    <NumberBox
                        Grid.Column="5"
                        MinWidth="{StaticResource NumberBoxMinWidth}"
                        VerticalAlignment="Center"
                        Maximum="{Binding LevelMax}"
                        Minimum="{Binding LevelCurrent, Mode=OneWay}"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding LevelTarget, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentDialog.Resources>
    <Grid Margin="0,8,0,0" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Visibility="{x:Bind Avatar, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
            <Grid
                Padding="8"
                ColumnSpacing="6"
                DataContext="{x:Bind Avatar}"
                Style="{ThemeResource GridCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxc:ItemIcon
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Icon="{Binding Icon}"
                    Quality="{Binding Quality}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"/>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsPromotionAvailable}">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_4947"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:CheckBox"
                        Value="{Binding CheckBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassCheckBox
                                VerticalAlignment="Center"
                                materialtheme:ControlMaterialState.IsManaged="True"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </StackPanel>
                <NumberBox
                    Grid.Column="3"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelMin}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                <FontIcon
                    Grid.Column="4"
                    Margin="8"
                    FontSize="12"
                    Glyph="&#xEBE7;"/>
                <NumberBox
                    Grid.Column="5"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelCurrent, Mode=OneWay}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelTarget, Mode=TwoWay}"/>
            </Grid>

            <ItemsControl ItemTemplate="{StaticResource SkillTemplate}" ItemsSource="{x:Bind Avatar.Skills}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Visibility="{x:Bind Weapon, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
            <Grid
                Padding="8"
                ColumnSpacing="6"
                DataContext="{x:Bind Weapon}"
                Style="{ThemeResource GridCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxc:ItemIcon
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Icon="{Binding Icon}"
                    Quality="{Binding Quality}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"/>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsPromotionAvailable}">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_7724"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:CheckBox"
                        Value="{Binding CheckBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassCheckBox
                                VerticalAlignment="Center"
                                materialtheme:ControlMaterialState.IsManaged="True"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </StackPanel>
                <NumberBox
                    Grid.Column="3"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelMin}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                <FontIcon
                    Grid.Column="4"
                    Margin="8"
                    FontSize="12"
                    Glyph="&#xEBE7;"/>
                <NumberBox
                    Grid.Column="5"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelCurrent, Mode=OneWay}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelTarget, Mode=TwoWay}"/>
            </Grid>
        </StackPanel>

        <RadioButtons
            x:Name="SaveModeSelector"
            Grid.Row="2"
            Margin="0,10,0,0"
            Header="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyHeader}"
            SelectedIndex="0">
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_9260"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_9260, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_9260"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyPreserveExisting}"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_9260, Mode=OneWay}"
                        GroupName="GlassRadioGroup_9010"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_9260, Mode=OneWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_9260Glass"
                        Width="{Binding Width, ElementName=GlassNative_9260, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_9260, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_9260, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_9260, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_9260, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_9260, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_9260, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_9260}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_9260, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_9260, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_9260, Mode=OneWay}"
                        Content="{Binding Content, ElementName=GlassNative_9260, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_9260, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_9260, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_9260, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_9260, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_9260, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_9260, Mode=OneWay}"
                        GroupName="GlassRadioGroup_9010Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_9260, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_9260, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_9386"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_9386, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_9386"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyOverwriteExisting}"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_9386, Mode=OneWay}"
                        GroupName="GlassRadioGroup_9010"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_9386, Mode=OneWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_9386Glass"
                        Width="{Binding Width, ElementName=GlassNative_9386, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_9386, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_9386, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_9386, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_9386, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_9386, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_9386, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_9386}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_9386, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_9386, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_9386, Mode=OneWay}"
                        Content="{Binding Content, ElementName=GlassNative_9386, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_9386, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_9386, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_9386, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_9386, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_9386, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_9386, Mode=OneWay}"
                        GroupName="GlassRadioGroup_9010Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_9386, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_9386, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_9513"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_9513, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_9513"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyCreateNewEntry}"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_9513, Mode=OneWay}"
                        GroupName="GlassRadioGroup_9010"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_9513, Mode=OneWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_9513Glass"
                        Width="{Binding Width, ElementName=GlassNative_9513, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_9513, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_9513, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_9513, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_9513, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_9513, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_9513, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_9513}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_9513, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_9513, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_9513, Mode=OneWay}"
                        Content="{Binding Content, ElementName=GlassNative_9513, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_9513, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_9513, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_9513, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_9513, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_9513, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_9513, Mode=OneWay}"
                        GroupName="GlassRadioGroup_9010Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_9513, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_9513, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
        </RadioButtons>
    </Grid>
</ContentDialog>
