<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.DownloadSourceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogDownloadSourceTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock
            Opacity="0.8"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceHint}"
            TextWrapping="Wrap"/>
        <RadioButtons x:Name="DownloadSourceSelector" SelectedIndex="0">
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1125"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_1125, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_1125"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_1125, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1125, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficial}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficialDescription}"/>
                        </StackPanel>
                    </RadioButton>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_1125Glass"
                        Width="{Binding Width, ElementName=GlassNative_1125, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_1125, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_1125, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_1125, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_1125, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_1125, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_1125, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_1125}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_1125, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_1125, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_1125, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_1125, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_1125, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_1125, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_1125, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_1125, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_1125, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_1125, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_1125, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficial}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficialDescription}"/>
                        </StackPanel>
                    </materialcontrols:LiquidGlassRadioButton>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1616"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{Binding Visibility, ElementName=GlassNative_1616, Mode=OneWay}"
                Value="{Binding RadioButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_1616"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_1616, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1616, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyan}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyanDescription}"/>
                        </StackPanel>
                    </RadioButton>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassRadioButton
                        x:Name="GlassNative_1616Glass"
                        Width="{Binding Width, ElementName=GlassNative_1616, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GlassNative_1616, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GlassNative_1616, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GlassNative_1616, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GlassNative_1616, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GlassNative_1616, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GlassNative_1616, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_1616}"
                        BorderThickness="{Binding BorderThickness, ElementName=GlassNative_1616, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GlassNative_1616, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GlassNative_1616, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GlassNative_1616, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GlassNative_1616, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GlassNative_1616, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GlassNative_1616, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GlassNative_1616, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GlassNative_1616, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024Glass"
                        IsChecked="{Binding IsChecked, ElementName=GlassNative_1616, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GlassNative_1616, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyan}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyanDescription}"/>
                        </StackPanel>
                    </materialcontrols:LiquidGlassRadioButton>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
        </RadioButtons>
    </StackPanel>
</ContentDialog>
