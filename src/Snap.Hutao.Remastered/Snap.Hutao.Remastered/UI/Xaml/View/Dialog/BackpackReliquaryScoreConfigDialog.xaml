<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.BackpackReliquaryScoreConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigApply}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Width="420" Spacing="12">
        <!--  Preset selector + buttons  -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1097"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:ComboBox"
                Visibility="{Binding Visibility, ElementName=PresetComboBox, Mode=OneWay}"
                Value="{Binding ComboBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <ComboBox
                        x:Name="PresetComboBox"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_1097, Mode=OneWay}"
                        DisplayMemberPath="DisplayName"
                        Header="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigPresetHeader}"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1097, Mode=OneWay}"
                        SelectionChanged="OnPresetComboBoxSelectionChanged"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassComboBox
                        x:Name="PresetComboBoxGlass"
                        Width="{Binding Width, ElementName=PresetComboBox, Mode=OneWay}"
                        Height="{Binding Height, ElementName=PresetComboBox, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=PresetComboBox, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=PresetComboBox, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=PresetComboBox, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=PresetComboBox, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=PresetComboBox, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=PresetComboBox}"
                        BorderThickness="{Binding BorderThickness, ElementName=PresetComboBox, Mode=OneWay}"
                        DisplayMemberPath="{Binding DisplayMemberPath, ElementName=PresetComboBox, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=PresetComboBox, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=PresetComboBox, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=PresetComboBox, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=PresetComboBox, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=PresetComboBox, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=PresetComboBox, Mode=OneWay}"
                        Header="{Binding Header, ElementName=PresetComboBox, Mode=OneWay}"
                        HeaderTemplate="{Binding HeaderTemplate, ElementName=PresetComboBox, Mode=OneWay}"
                        IsDropDownOpen="{Binding IsDropDownOpen, ElementName=PresetComboBox, Mode=TwoWay}"
                        IsEditable="{Binding IsEditable, ElementName=PresetComboBox, Mode=OneWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=PresetComboBox, Mode=OneWay}"
                        IsTextSearchEnabled="{Binding IsTextSearchEnabled, ElementName=PresetComboBox, Mode=OneWay}"
                        ItemsSource="{Binding ItemsSource, ElementName=PresetComboBox, Mode=OneWay}"
                        MaxDropDownHeight="{Binding MaxDropDownHeight, ElementName=PresetComboBox, Mode=OneWay}"
                        PlaceholderText="{Binding PlaceholderText, ElementName=PresetComboBox, Mode=OneWay}"
                        SelectedIndex="{Binding SelectedIndex, ElementName=PresetComboBox, Mode=TwoWay}"
                        SelectedValuePath="{Binding SelectedValuePath, ElementName=PresetComboBox, Mode=OneWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <materialcases:SwitchPresenter
                    x:Name="GlassPresenter_1522"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>0</x:Int32>
                        </materialcases:Case.Value>
                        <Button Click="OnNewConfigClick" Content="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigNewConfig}"/>
                    </materialcases:Case>
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>1</x:Int32>
                        </materialcases:Case.Value>
                        <materialcontrols:LiquidGlassButton
                            materialtheme:ControlMaterialState.IsManaged="True"
                            Click="OnNewConfigClick"
                            Content="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigNewConfig}"/>
                    </materialcases:Case>
                </materialcases:SwitchPresenter>
                <materialcases:SwitchPresenter
                    x:Name="GlassPresenter_1699"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Visibility="{Binding Visibility, ElementName=DeleteButton, Mode=OneWay}"
                    Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>0</x:Int32>
                        </materialcases:Case.Value>
                        <Button
                            x:Name="DeleteButton"
                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                            Click="OnDeleteConfigClick"
                            Content="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigDeleteConfig}"
                            DataContext="{Binding DataContext, ElementName=GlassPresenter_1699, Mode=OneWay}"
                            Foreground="White"
                            RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1699, Mode=OneWay}"
                            Visibility="Collapsed"/>
                    </materialcases:Case>
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>1</x:Int32>
                        </materialcases:Case.Value>
                        <materialcontrols:LiquidGlassButton
                            x:Name="DeleteButtonGlass"
                            Width="{Binding Width, ElementName=DeleteButton, Mode=OneWay}"
                            Height="{Binding Height, ElementName=DeleteButton, Mode=OneWay}"
                            MinWidth="{Binding MinWidth, ElementName=DeleteButton, Mode=OneWay}"
                            MinHeight="{Binding MinHeight, ElementName=DeleteButton, Mode=OneWay}"
                            MaxWidth="{Binding MaxWidth, ElementName=DeleteButton, Mode=OneWay}"
                            MaxHeight="{Binding MaxHeight, ElementName=DeleteButton, Mode=OneWay}"
                            Padding="{Binding Padding, ElementName=DeleteButton, Mode=OneWay}"
                            materialtheme:ControlMaterialState.IsManaged="True"
                            materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=DeleteButton}"
                            BorderThickness="{Binding BorderThickness, ElementName=DeleteButton, Mode=OneWay}"
                            Click="OnDeleteConfigClick"
                            Command="{Binding Command, ElementName=DeleteButton, Mode=OneWay}"
                            CommandParameter="{Binding CommandParameter, ElementName=DeleteButton, Mode=OneWay}"
                            Content="{Binding Content, ElementName=DeleteButton, Mode=OneWay}"
                            FlowDirection="{Binding FlowDirection, ElementName=DeleteButton, Mode=OneWay}"
                            FontFamily="{Binding FontFamily, ElementName=DeleteButton, Mode=OneWay}"
                            FontSize="{Binding FontSize, ElementName=DeleteButton, Mode=OneWay}"
                            FontStyle="{Binding FontStyle, ElementName=DeleteButton, Mode=OneWay}"
                            FontWeight="{Binding FontWeight, ElementName=DeleteButton, Mode=OneWay}"
                            Foreground="{Binding Foreground, ElementName=DeleteButton, Mode=OneWay}"
                            IsEnabled="{Binding IsEnabled, ElementName=DeleteButton, Mode=OneWay}"/>
                    </materialcases:Case>
                </materialcases:SwitchPresenter>
            </StackPanel>
        </Grid>

        <!--  Name  -->
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_2141"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Visibility="{Binding Visibility, ElementName=NameTextBox, Mode=OneWay}"
            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <TextBox
                    x:Name="NameTextBox"
                    DataContext="{Binding DataContext, ElementName=GlassPresenter_2141, Mode=OneWay}"
                    Header="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigNameHeader}"
                    RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_2141, Mode=OneWay}"
                    TextChanged="OnNameTextChanged"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassTextBox
                    x:Name="NameTextBoxGlass"
                    Width="{Binding Width, ElementName=NameTextBox, Mode=OneWay}"
                    Height="{Binding Height, ElementName=NameTextBox, Mode=OneWay}"
                    MinWidth="{Binding MinWidth, ElementName=NameTextBox, Mode=OneWay}"
                    MinHeight="{Binding MinHeight, ElementName=NameTextBox, Mode=OneWay}"
                    MaxWidth="{Binding MaxWidth, ElementName=NameTextBox, Mode=OneWay}"
                    MaxHeight="{Binding MaxHeight, ElementName=NameTextBox, Mode=OneWay}"
                    Padding="{Binding Padding, ElementName=NameTextBox, Mode=OneWay}"
                    materialtheme:ControlMaterialState.IsManaged="True"
                    materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=NameTextBox}"
                    AcceptsReturn="{Binding AcceptsReturn, ElementName=NameTextBox, Mode=OneWay}"
                    BorderThickness="{Binding BorderThickness, ElementName=NameTextBox, Mode=OneWay}"
                    CharacterCasing="{Binding CharacterCasing, ElementName=NameTextBox, Mode=OneWay}"
                    FlowDirection="{Binding FlowDirection, ElementName=NameTextBox, Mode=OneWay}"
                    FontFamily="{Binding FontFamily, ElementName=NameTextBox, Mode=OneWay}"
                    FontSize="{Binding FontSize, ElementName=NameTextBox, Mode=OneWay}"
                    FontStyle="{Binding FontStyle, ElementName=NameTextBox, Mode=OneWay}"
                    FontWeight="{Binding FontWeight, ElementName=NameTextBox, Mode=OneWay}"
                    Foreground="{Binding Foreground, ElementName=NameTextBox, Mode=OneWay}"
                    Header="{Binding Header, ElementName=NameTextBox, Mode=OneWay}"
                    HeaderTemplate="{Binding HeaderTemplate, ElementName=NameTextBox, Mode=OneWay}"
                    InputScope="{Binding InputScope, ElementName=NameTextBox, Mode=OneWay}"
                    IsEnabled="{Binding IsEnabled, ElementName=NameTextBox, Mode=OneWay}"
                    IsReadOnly="{Binding IsReadOnly, ElementName=NameTextBox, Mode=OneWay}"
                    MaxLength="{Binding MaxLength, ElementName=NameTextBox, Mode=OneWay}"
                    PlaceholderText="{Binding PlaceholderText, ElementName=NameTextBox, Mode=OneWay}"
                    SelectionHighlightColor="{Binding SelectionHighlightColor, ElementName=NameTextBox, Mode=OneWay}"
                    Text="{Binding Text, ElementName=NameTextBox, Mode=TwoWay}"
                    TextAlignment="{Binding TextAlignment, ElementName=NameTextBox, Mode=OneWay}"
                    TextWrapping="{Binding TextWrapping, ElementName=NameTextBox, Mode=OneWay}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>

        <!--  Weight sliders  -->
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigWeightsHeader}"/>
        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--  Crit Rate  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigCrit}"/>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_3360"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Slider"
                Visibility="{Binding Visibility, ElementName=CritSlider, Mode=OneWay}"
                Value="{Binding SliderMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Slider
                        x:Name="CritSlider"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_3360, Mode=OneWay}"
                        Maximum="1.0"
                        Minimum="0"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_3360, Mode=OneWay}"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassSlider
                        x:Name="CritSliderGlass"
                        Width="{Binding Width, ElementName=CritSlider, Mode=OneWay}"
                        Height="{Binding Height, ElementName=CritSlider, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=CritSlider, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=CritSlider, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=CritSlider, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=CritSlider, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=CritSlider, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=CritSlider}"
                        BorderThickness="{Binding BorderThickness, ElementName=CritSlider, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=CritSlider, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=CritSlider, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=CritSlider, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=CritSlider, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=CritSlider, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=CritSlider, Mode=OneWay}"
                        Header="{Binding Header, ElementName=CritSlider, Mode=OneWay}"
                        HeaderTemplate="{Binding HeaderTemplate, ElementName=CritSlider, Mode=OneWay}"
                        IsDirectionReversed="{Binding IsDirectionReversed, ElementName=CritSlider, Mode=OneWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=CritSlider, Mode=OneWay}"
                        LargeChange="{Binding LargeChange, ElementName=CritSlider, Mode=OneWay}"
                        Maximum="{Binding Maximum, ElementName=CritSlider, Mode=OneWay}"
                        Minimum="{Binding Minimum, ElementName=CritSlider, Mode=OneWay}"
                        Orientation="{Binding Orientation, ElementName=CritSlider, Mode=OneWay}"
                        SmallChange="{Binding SmallChange, ElementName=CritSlider, Mode=OneWay}"
                        StepFrequency="{Binding StepFrequency, ElementName=CritSlider, Mode=OneWay}"
                        TickFrequency="{Binding TickFrequency, ElementName=CritSlider, Mode=OneWay}"
                        TickPlacement="{Binding TickPlacement, ElementName=CritSlider, Mode=OneWay}"
                        Value="{Binding Value, ElementName=CritSlider, Mode=TwoWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <TextBlock
                x:Name="CritLabel"
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  Crit Hurt  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigCritHurt}"/>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_4086"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Slider"
                Visibility="{Binding Visibility, ElementName=CritHurtSlider, Mode=OneWay}"
                Value="{Binding SliderMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Slider
                        x:Name="CritHurtSlider"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_4086, Mode=OneWay}"
                        Maximum="1.0"
                        Minimum="0"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_4086, Mode=OneWay}"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassSlider
                        x:Name="CritHurtSliderGlass"
                        Width="{Binding Width, ElementName=CritHurtSlider, Mode=OneWay}"
                        Height="{Binding Height, ElementName=CritHurtSlider, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=CritHurtSlider, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=CritHurtSlider, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=CritHurtSlider, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=CritHurtSlider, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=CritHurtSlider, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=CritHurtSlider}"
                        BorderThickness="{Binding BorderThickness, ElementName=CritHurtSlider, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=CritHurtSlider, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=CritHurtSlider, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=CritHurtSlider, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=CritHurtSlider, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=CritHurtSlider, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=CritHurtSlider, Mode=OneWay}"
                        Header="{Binding Header, ElementName=CritHurtSlider, Mode=OneWay}"
                        HeaderTemplate="{Binding HeaderTemplate, ElementName=CritHurtSlider, Mode=OneWay}"
                        IsDirectionReversed="{Binding IsDirectionReversed, ElementName=CritHurtSlider, Mode=OneWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=CritHurtSlider, Mode=OneWay}"
                        LargeChange="{Binding LargeChange, ElementName=CritHurtSlider, Mode=OneWay}"
                        Maximum="{Binding Maximum, ElementName=CritHurtSlider, Mode=OneWay}"
                        Minimum="{Binding Minimum, ElementName=CritHurtSlider, Mode=OneWay}"
                        Orientation="{Binding Orientation, ElementName=CritHurtSlider, Mode=OneWay}"
                        SmallChange="{Binding SmallChange, ElementName=CritHurtSlider, Mode=OneWay}"
                        StepFrequency="{Binding StepFrequency, ElementName=CritHurtSlider, Mode=OneWay}"
                        TickFrequency="{Binding TickFrequency, ElementName=CritHurtSlider, Mode=OneWay}"
                        TickPlacement="{Binding TickPlacement, ElementName=CritHurtSlider, Mode=OneWay}"
                        Value="{Binding Value, ElementName=CritHurtSlider, Mode=TwoWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <TextBlock
                x:Name="CritHurtLabel"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  ATK%  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigAttackPercent}"/>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_4820"
                Grid.Row="2"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Slider"
                Visibility="{Binding Visibility, ElementName=AttackPercentSlider, Mode=OneWay}"
                Value="{Binding SliderMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Slider
                        x:Name="AttackPercentSlider"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_4820, Mode=OneWay}"
                        Maximum="1.0"
                        Minimum="0"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_4820, Mode=OneWay}"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassSlider
                        x:Name="AttackPercentSliderGlass"
                        Width="{Binding Width, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Height="{Binding Height, ElementName=AttackPercentSlider, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=AttackPercentSlider, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=AttackPercentSlider, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=AttackPercentSlider, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=AttackPercentSlider, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=AttackPercentSlider}"
                        BorderThickness="{Binding BorderThickness, ElementName=AttackPercentSlider, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=AttackPercentSlider, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=AttackPercentSlider, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=AttackPercentSlider, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=AttackPercentSlider, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Header="{Binding Header, ElementName=AttackPercentSlider, Mode=OneWay}"
                        HeaderTemplate="{Binding HeaderTemplate, ElementName=AttackPercentSlider, Mode=OneWay}"
                        IsDirectionReversed="{Binding IsDirectionReversed, ElementName=AttackPercentSlider, Mode=OneWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=AttackPercentSlider, Mode=OneWay}"
                        LargeChange="{Binding LargeChange, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Maximum="{Binding Maximum, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Minimum="{Binding Minimum, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Orientation="{Binding Orientation, ElementName=AttackPercentSlider, Mode=OneWay}"
                        SmallChange="{Binding SmallChange, ElementName=AttackPercentSlider, Mode=OneWay}"
                        StepFrequency="{Binding StepFrequency, ElementName=AttackPercentSlider, Mode=OneWay}"
                        TickFrequency="{Binding TickFrequency, ElementName=AttackPercentSlider, Mode=OneWay}"
                        TickPlacement="{Binding TickPlacement, ElementName=AttackPercentSlider, Mode=OneWay}"
                        Value="{Binding Value, ElementName=AttackPercentSlider, Mode=TwoWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <TextBlock
                x:Name="AttackPercentLabel"
                Grid.Row="2"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  ER  -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigChargeEfficiency}"/>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_5565"
                Grid.Row="3"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Slider"
                Visibility="{Binding Visibility, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                Value="{Binding SliderMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Slider
                        x:Name="ChargeEfficiencySlider"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_5565, Mode=OneWay}"
                        Maximum="1.0"
                        Minimum="0"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_5565, Mode=OneWay}"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassSlider
                        x:Name="ChargeEfficiencySliderGlass"
                        Width="{Binding Width, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        Height="{Binding Height, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=ChargeEfficiencySlider}"
                        BorderThickness="{Binding BorderThickness, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=ChargeEfficiencySlider, Mode=OneWay}"
