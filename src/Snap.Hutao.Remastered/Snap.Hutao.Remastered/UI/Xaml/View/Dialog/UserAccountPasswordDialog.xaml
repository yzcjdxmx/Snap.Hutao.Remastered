<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.UserAccountPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsLoginEnabled, Mode=OneWay}"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_887"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <TextBox
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordAccountHint}"
                    Text="{x:Bind Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassTextBox
                    materialtheme:ControlMaterialState.IsManaged="True"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordAccountHint}"
                    Text="{x:Bind Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_1159"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:PasswordBox"
            Visibility="{Binding Visibility, ElementName=GlassNative_1159, Mode=OneWay}"
            Value="{Binding PasswordBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <PasswordBox
                    x:Name="GlassNative_1159"
                    DataContext="{Binding DataContext, ElementName=GlassPresenter_1159, Mode=OneWay}"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    Password="{x:Bind Password, Mode=TwoWay}"
                    PasswordChar="*"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordPasswordHint}"
                    RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1159, Mode=OneWay}"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassPasswordBox
                    x:Name="GlassNative_1159Glass"
                    Width="{Binding Width, ElementName=GlassNative_1159, Mode=OneWay}"
                    Height="{Binding Height, ElementName=GlassNative_1159, Mode=OneWay}"
                    MinWidth="{Binding MinWidth, ElementName=GlassNative_1159, Mode=OneWay}"
                    MinHeight="{Binding MinHeight, ElementName=GlassNative_1159, Mode=OneWay}"
                    MaxWidth="{Binding MaxWidth, ElementName=GlassNative_1159, Mode=OneWay}"
                    MaxHeight="{Binding MaxHeight, ElementName=GlassNative_1159, Mode=OneWay}"
                    Padding="{Binding Padding, ElementName=GlassNative_1159, Mode=OneWay}"
                    materialtheme:ControlMaterialState.IsManaged="True"
                    materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GlassNative_1159}"
                    BorderThickness="{Binding BorderThickness, ElementName=GlassNative_1159, Mode=OneWay}"
                    FlowDirection="{Binding FlowDirection, ElementName=GlassNative_1159, Mode=OneWay}"
                    FontFamily="{Binding FontFamily, ElementName=GlassNative_1159, Mode=OneWay}"
                    FontSize="{Binding FontSize, ElementName=GlassNative_1159, Mode=OneWay}"
                    FontStyle="{Binding FontStyle, ElementName=GlassNative_1159, Mode=OneWay}"
                    FontWeight="{Binding FontWeight, ElementName=GlassNative_1159, Mode=OneWay}"
                    Foreground="{Binding Foreground, ElementName=GlassNative_1159, Mode=OneWay}"
                    IsEnabled="{Binding IsEnabled, ElementName=GlassNative_1159, Mode=OneWay}"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    Password="{Binding Password, ElementName=GlassNative_1159, Mode=TwoWay}"
                    PlaceholderText="{Binding PlaceholderText, ElementName=GlassNative_1159, Mode=OneWay}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
    </StackPanel>
</ContentDialog>
