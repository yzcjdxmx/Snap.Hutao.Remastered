<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.LaunchExecutionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuv="using:Snap.Hutao.Remastered.UI.Xaml.View"
    Title="LaunchExecutionOverlayWindow"
    mc:Ignorable="d">

    <Border x:Name="RootBorder">
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="112"/>
            </Grid.ColumnDefinitions>
            <shuv:OverlayView x:Name="RootView"/>
            <ToggleButton
                x:Name="FpsToggle"
                Grid.Column="1"
                Margin="0,0,4,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.Name="游戏性能面板"
                Click="OnFpsToggleClick"
                IsEnabled="False"
                ToolTipService.ToolTip="打开或关闭独立的 FPS 和 1% Low 性能面板。">
                <TextBlock HorizontalAlignment="Center" Text="性能面板"/>
            </ToggleButton>
        </Grid>
    </Border>
</Window>
