<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.LaunchExecutionPerformanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="游戏性能">
    <Border x:Name="RootBorder" Background="#E21B2029" CornerRadius="8" Padding="12,5">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="FpsMetric" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="#BBC9DB" Text="FPS"/>
                <TextBlock x:Name="FpsValue" FontSize="23" FontWeight="SemiBold" Foreground="White" Text="—"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="#BBC9DB" Text="1% Low"/>
                <TextBlock x:Name="LowValue" FontSize="23" FontWeight="SemiBold" Foreground="White" Text="—"/>
            </StackPanel>
            <Button x:Name="CloseButton"
                Grid.Column="2"
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                Padding="0"
                AutomationProperties.Name="关闭游戏性能面板"
                Background="Transparent"
                BorderThickness="0"
                Click="OnCloseClick"
                Foreground="#BBC9DB"
                ToolTipService.ToolTip="关闭性能面板">
                <FontIcon FontSize="12" Glyph="&#xE711;"/>
            </Button>
        </Grid>
    </Border>
</Window>
