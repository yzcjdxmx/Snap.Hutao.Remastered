<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.ScriptingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvs="using:Snap.Hutao.Remastered.ViewModel.Scripting"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!--  Title  -->
            <RowDefinition Height="auto"/>
            <!--  UserArea  -->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="DragableGrid"
            Grid.Row="0"
            Height="32">
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewWindowScriptingTitle}"/>
        </Grid>
        <Grid
            x:Name="RootGrid"
            Grid.Row="1"
            Padding="16"
            d:DataContext="{d:DesignInstance Type=shvs:ScriptingViewModel}"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <!--  Input  -->
                <RowDefinition Height="auto"/>
                <!--  Command  -->
                <RowDefinition Height="auto"/>
                <!--  Result  -->
                <RowDefinition/>
            </Grid.RowDefinitions>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1568"
                Grid.Row="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:TextBox"
                Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <TextBox
                        AcceptsReturn="True"
                        IsSpellCheckEnabled="False"
                        Text="{Binding InputScript, Mode=TwoWay}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassTextBox
                        materialtheme:ControlMaterialState.IsManaged="True"
                        AcceptsReturn="True"
                        IsSpellCheckEnabled="False"
                        Text="{Binding InputScript, Mode=TwoWay}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <materialcases:SwitchPresenter
                    x:Name="GlassPresenter_1989"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:HyperlinkButton"
                    Value="{Binding HyperlinkButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>0</x:Int32>
                        </materialcases:Case.Value>
                        <HyperlinkButton
                            VerticalAlignment="Stretch"
                            Content="&#xE946;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            NavigateUri="https://github.com/DGP-Studio/Snap.Hutao.Remastered/blob/main/src/Snap.Hutao.Remastered/Snap.Hutao.Remastered/Core/Scripting/ScriptContext.cs"/>
                    </materialcases:Case>
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>1</x:Int32>
                        </materialcases:Case.Value>
                        <materialcontrols:LiquidGlassHyperlinkButton
                            VerticalAlignment="Stretch"
                            materialtheme:ControlMaterialState.IsManaged="True"
                            Content="&#xE946;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            NavigateUri="https://github.com/DGP-Studio/Snap.Hutao.Remastered/blob/main/src/Snap.Hutao.Remastered/Snap.Hutao.Remastered/Core/Scripting/ScriptContext.cs"/>
                    </materialcases:Case>
                </materialcases:SwitchPresenter>
                <materialcases:SwitchPresenter
                    x:Name="GlassPresenter_2358"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>0</x:Int32>
                        </materialcases:Case.Value>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding ExecuteScriptCommand}"
                            Content="{shuxm:ResourceString Name=ViewWindowScriptingExecute}"/>
                    </materialcases:Case>
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>1</x:Int32>
                        </materialcases:Case.Value>
                        <materialcontrols:LiquidGlassButton
                            HorizontalAlignment="Stretch"
                            materialtheme:ControlMaterialState.IsManaged="True"
                            Command="{Binding ExecuteScriptCommand}"
                            Content="{shuxm:ResourceString Name=ViewWindowScriptingExecute}"/>
                    </materialcases:Case>
                </materialcases:SwitchPresenter>
            </Grid>

            <Border Grid.Row="2" Style="{ThemeResource BorderCardStyle}">
                <ScrollViewer>
                    <TextBlock
                        Margin="8"
                        IsTextSelectionEnabled="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{Binding OutputResult, Mode=OneWay}"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
