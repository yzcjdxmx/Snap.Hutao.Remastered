<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.WebView2.WebView2Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    mc:Ignorable="d">

    <Grid ActualThemeChanged="OnActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_871"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Visibility="{Binding Visibility, ElementName=GoBackButton, Mode=OneWay}"
                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Button
                        x:Name="GoBackButton"
                        MinWidth="44"
                        Command="{x:Bind GoBackCommand}"
                        DataContext="{Binding DataContext, ElementName=GlassPresenter_871, Mode=OneWay}"
                        FontSize="12"
                        RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_871, Mode=OneWay}"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassButton
                        x:Name="GoBackButtonGlass"
                        Width="{Binding Width, ElementName=GoBackButton, Mode=OneWay}"
                        Height="{Binding Height, ElementName=GoBackButton, Mode=OneWay}"
                        MinWidth="{Binding MinWidth, ElementName=GoBackButton, Mode=OneWay}"
                        MinHeight="{Binding MinHeight, ElementName=GoBackButton, Mode=OneWay}"
                        MaxWidth="{Binding MaxWidth, ElementName=GoBackButton, Mode=OneWay}"
                        MaxHeight="{Binding MaxHeight, ElementName=GoBackButton, Mode=OneWay}"
                        Padding="{Binding Padding, ElementName=GoBackButton, Mode=OneWay}"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GoBackButton}"
                        BorderThickness="{Binding BorderThickness, ElementName=GoBackButton, Mode=OneWay}"
                        Command="{Binding Command, ElementName=GoBackButton, Mode=OneWay}"
                        CommandParameter="{Binding CommandParameter, ElementName=GoBackButton, Mode=OneWay}"
                        Content="{Binding Content, ElementName=GoBackButton, Mode=OneWay}"
                        FlowDirection="{Binding FlowDirection, ElementName=GoBackButton, Mode=OneWay}"
                        FontFamily="{Binding FontFamily, ElementName=GoBackButton, Mode=OneWay}"
                        FontSize="{Binding FontSize, ElementName=GoBackButton, Mode=OneWay}"
                        FontStyle="{Binding FontStyle, ElementName=GoBackButton, Mode=OneWay}"
                        FontWeight="{Binding FontWeight, ElementName=GoBackButton, Mode=OneWay}"
                        Foreground="{Binding Foreground, ElementName=GoBackButton, Mode=OneWay}"
                        IsEnabled="{Binding IsEnabled, ElementName=GoBackButton, Mode=OneWay}"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <materialcases:SwitchPresenter
                x:Name="GlassPresenter_1144"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>0</x:Int32>
                    </materialcases:Case.Value>
                    <Button
                        MinWidth="44"
                        Command="{x:Bind RefreshCommand}"
                        Content="&#xE72C;"
                        FontSize="12"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                </materialcases:Case>
                <materialcases:Case>
                    <materialcases:Case.Value>
                        <x:Int32>1</x:Int32>
                    </materialcases:Case.Value>
                    <materialcontrols:LiquidGlassButton
                        MinWidth="44"
                        materialtheme:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind RefreshCommand}"
                        Content="&#xE72C;"
                        FontSize="12"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                </materialcases:Case>
            </materialcases:SwitchPresenter>
            <Grid
                x:Name="TitleArea"
                Grid.Column="2"
                IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="DocumentTitle"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <TextBlock
            x:Name="WebView2LoadFailedHintText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{shuxm:ResourceString Name=ViewWebView2WindowLoadFailedHint}"
            Visibility="Collapsed"/>
        <WebView2
            x:Name="WebView"
            Grid.Row="1"
            DefaultBackgroundColor="Transparent"/>
    </Grid>
</Window>
