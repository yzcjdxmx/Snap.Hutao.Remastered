<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.WebView2.CompactWebView2Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialcases="using:CommunityToolkit.WinUI.Controls"
    xmlns:materialcontrols="using:WinUI.LiquidGlass"
    xmlns:materialtheme="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRowDefinition" Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <materialcases:SwitchPresenter
                    x:Name="GlassPresenter_1099"
                    Grid.Column="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Visibility="{Binding Visibility, ElementName=GoBackButton, Mode=OneWay}"
                    Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>0</x:Int32>
                        </materialcases:Case.Value>
                        <Button
                            x:Name="GoBackButton"
                            Height="48"
                            MinWidth="48"
                            Command="{x:Bind GoBackCommand}"
                            DataContext="{Binding DataContext, ElementName=GlassPresenter_1099, Mode=OneWay}"
                            FontSize="12"
                            RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1099, Mode=OneWay}"
                            Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                    </materialcases:Case>
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>1</x:Int32>
                        </materialcases:Case.Value>
                        <materialcontrols:LiquidGlassButton
                            x:Name="GoBackButtonGlass"
                            Width="{Binding Width, ElementName=GoBackButton, Mode=OneWay}"
                            Height="{Binding Height, ElementName=GoBackButton, Mode=OneWay}"
                            MinWidth="{Binding MinWidth, ElementName=GoBackButton, Mode=OneWay}"
                            MinHeight="{Binding MinHeight, ElementName=GoBackButton, Mode=OneWay}"
                            MaxWidth="{Binding MaxWidth, ElementName=GoBackButton, Mode=OneWay}"
                            MaxHeight="{Binding MaxHeight, ElementName=GoBackButton, Mode=OneWay}"
                            Padding="{Binding Padding, ElementName=GoBackButton, Mode=OneWay}"
                            materialtheme:ControlMaterialState.IsManaged="True"
                            materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=GoBackButton}"
                            BorderThickness="{Binding BorderThickness, ElementName=GoBackButton, Mode=OneWay}"
                            Command="{Binding Command, ElementName=GoBackButton, Mode=OneWay}"
                            CommandParameter="{Binding CommandParameter, ElementName=GoBackButton, Mode=OneWay}"
                            Content="{Binding Content, ElementName=GoBackButton, Mode=OneWay}"
                            FlowDirection="{Binding FlowDirection, ElementName=GoBackButton, Mode=OneWay}"
                            FontFamily="{Binding FontFamily, ElementName=GoBackButton, Mode=OneWay}"
                            FontSize="{Binding FontSize, ElementName=GoBackButton, Mode=OneWay}"
                            FontStyle="{Binding FontStyle, ElementName=GoBackButton, Mode=OneWay}"
                            FontWeight="{Binding FontWeight, ElementName=GoBackButton, Mode=OneWay}"
                            Foreground="{Binding Foreground, ElementName=GoBackButton, Mode=OneWay}"
                            IsEnabled="{Binding IsEnabled, ElementName=GoBackButton, Mode=OneWay}"
                            Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                    </materialcases:Case>
                </materialcases:SwitchPresenter>
                <materialcases:SwitchPresenter
                    x:Name="GlassPresenter_1432"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Visibility="{Binding Visibility, ElementName=RefreshButton, Mode=OneWay}"
                    Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>0</x:Int32>
                        </materialcases:Case.Value>
                        <Button
                            x:Name="RefreshButton"
                            Height="48"
                            MinWidth="48"
                            Content="&#xE72C;"
                            DataContext="{Binding DataContext, ElementName=GlassPresenter_1432, Mode=OneWay}"
                            FontSize="12"
                            RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_1432, Mode=OneWay}"
                            Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                    </materialcases:Case>
                    <materialcases:Case>
                        <materialcases:Case.Value>
                            <x:Int32>1</x:Int32>
                        </materialcases:Case.Value>
                        <materialcontrols:LiquidGlassButton
                            x:Name="RefreshButtonGlass"
                            Width="{Binding Width, ElementName=RefreshButton, Mode=OneWay}"
                            Height="{Binding Height, ElementName=RefreshButton, Mode=OneWay}"
                            MinWidth="{Binding MinWidth, ElementName=RefreshButton, Mode=OneWay}"
                            MinHeight="{Binding MinHeight, ElementName=RefreshButton, Mode=OneWay}"
                            MaxWidth="{Binding MaxWidth, ElementName=RefreshButton, Mode=OneWay}"
                            MaxHeight="{Binding MaxHeight, ElementName=RefreshButton, Mode=OneWay}"
                            Padding="{Binding Padding, ElementName=RefreshButton, Mode=OneWay}"
                            materialtheme:ControlMaterialState.IsManaged="True"
                            materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=RefreshButton}"
                            BorderThickness="{Binding BorderThickness, ElementName=RefreshButton, Mode=OneWay}"
                            Command="{Binding Command, ElementName=RefreshButton, Mode=OneWay}"
                            CommandParameter="{Binding CommandParameter, ElementName=RefreshButton, Mode=OneWay}"
                            Content="{Binding Content, ElementName=RefreshButton, Mode=OneWay}"
                            FlowDirection="{Binding FlowDirection, ElementName=RefreshButton, Mode=OneWay}"
                            FontFamily="{Binding FontFamily, ElementName=RefreshButton, Mode=OneWay}"
                            FontSize="{Binding FontSize, ElementName=RefreshButton, Mode=OneWay}"
                            FontStyle="{Binding FontStyle, ElementName=RefreshButton, Mode=OneWay}"
                            FontWeight="{Binding FontWeight, ElementName=RefreshButton, Mode=OneWay}"
                            Foreground="{Binding Foreground, ElementName=RefreshButton, Mode=OneWay}"
                            IsEnabled="{Binding IsEnabled, ElementName=RefreshButton, Mode=OneWay}"
                            Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                    </materialcases:Case>
                </materialcases:SwitchPresenter>
                <ProgressRing
                    x:Name="ProgressRing"
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    Margin="16,2,4,2"
                    IsActive="True"
                    IsIndeterminate="True"
                    Visibility="Collapsed"/>
                <Grid x:Name="TitleArea" Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DocumentTitle"
                        Grid.Column="0"
                        MaxWidth="120"
                        Margin="12,4,0,4"
                        VerticalAlignment="Center"
                        SizeChanged="OnDocumentTitleSizeChanged"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"/>
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_2769"
                        Grid.Column="1"
                        Margin="8"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:TextBox"
                        Visibility="{Binding Visibility, ElementName=SourceTextBox, Mode=OneWay}"
                        Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <TextBox
                                x:Name="SourceTextBox"
                                VerticalAlignment="Top"
                                DataContext="{Binding DataContext, ElementName=GlassPresenter_2769, Mode=OneWay}"
                                KeyDown="OnSourceTextBoxKeyDown"
                                RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_2769, Mode=OneWay}"
                                Text="{x:Bind Source, Mode=TwoWay}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassTextBox
                                x:Name="SourceTextBoxGlass"
                                Width="{Binding Width, ElementName=SourceTextBox, Mode=OneWay}"
                                Height="{Binding Height, ElementName=SourceTextBox, Mode=OneWay}"
                                MinWidth="{Binding MinWidth, ElementName=SourceTextBox, Mode=OneWay}"
                                MinHeight="{Binding MinHeight, ElementName=SourceTextBox, Mode=OneWay}"
                                MaxWidth="{Binding MaxWidth, ElementName=SourceTextBox, Mode=OneWay}"
                                MaxHeight="{Binding MaxHeight, ElementName=SourceTextBox, Mode=OneWay}"
                                Padding="{Binding Padding, ElementName=SourceTextBox, Mode=OneWay}"
                                VerticalAlignment="Top"
                                materialtheme:ControlMaterialState.IsManaged="True"
                                materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=SourceTextBox}"
                                AcceptsReturn="{Binding AcceptsReturn, ElementName=SourceTextBox, Mode=OneWay}"
                                BorderThickness="{Binding BorderThickness, ElementName=SourceTextBox, Mode=OneWay}"
                                CharacterCasing="{Binding CharacterCasing, ElementName=SourceTextBox, Mode=OneWay}"
                                FlowDirection="{Binding FlowDirection, ElementName=SourceTextBox, Mode=OneWay}"
                                FontFamily="{Binding FontFamily, ElementName=SourceTextBox, Mode=OneWay}"
                                FontSize="{Binding FontSize, ElementName=SourceTextBox, Mode=OneWay}"
                                FontStyle="{Binding FontStyle, ElementName=SourceTextBox, Mode=OneWay}"
                                FontWeight="{Binding FontWeight, ElementName=SourceTextBox, Mode=OneWay}"
                                Foreground="{Binding Foreground, ElementName=SourceTextBox, Mode=OneWay}"
                                Header="{Binding Header, ElementName=SourceTextBox, Mode=OneWay}"
                                HeaderTemplate="{Binding HeaderTemplate, ElementName=SourceTextBox, Mode=OneWay}"
                                InputScope="{Binding InputScope, ElementName=SourceTextBox, Mode=OneWay}"
                                IsEnabled="{Binding IsEnabled, ElementName=SourceTextBox, Mode=OneWay}"
                                IsReadOnly="{Binding IsReadOnly, ElementName=SourceTextBox, Mode=OneWay}"
                                KeyDown="OnSourceTextBoxKeyDown"
                                MaxLength="{Binding MaxLength, ElementName=SourceTextBox, Mode=OneWay}"
                                PlaceholderText="{Binding PlaceholderText, ElementName=SourceTextBox, Mode=OneWay}"
                                SelectionHighlightColor="{Binding SelectionHighlightColor, ElementName=SourceTextBox, Mode=OneWay}"
                                Text="{Binding Text, ElementName=SourceTextBox, Mode=TwoWay}"
                                TextAlignment="{Binding TextAlignment, ElementName=SourceTextBox, Mode=OneWay}"
                                TextWrapping="{Binding TextWrapping, ElementName=SourceTextBox, Mode=OneWay}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </Grid>
                <StackPanel
                    Grid.Column="4"
                    Margin="48,0,0,0"
                    Orientation="Horizontal">
                    <materialcases:SwitchPresenter
                        x:Name="GlassPresenter_3259"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>0</x:Int32>
                            </materialcases:Case.Value>
                            <Button
                                Height="48"
                                MinWidth="44"
                                Command="{x:Bind CloseCommand}"
                                Content="&#xE711;"
                                FontSize="12"
                                Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                        </materialcases:Case>
                        <materialcases:Case>
                            <materialcases:Case.Value>
                                <x:Int32>1</x:Int32>
                            </materialcases:Case.Value>
                            <materialcontrols:LiquidGlassButton
                                Height="48"
                                MinWidth="44"
                                materialtheme:ControlMaterialState.IsManaged="True"
                                Command="{x:Bind CloseCommand}"
                                Content="&#xE711;"
                                FontSize="12"
                                Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                        </materialcases:Case>
                    </materialcases:SwitchPresenter>
                </StackPanel>
            </Grid>
            <InfoBar
                x:Name="HotKeyDisabledInfoBar"
                Grid.Row="1"
                IsClosable="True"
                IsOpen="True"
                Message="{shuxm:ResourceString Name=ViewWindowCompactWebView2HotKeyDisabledMessage}"
                Severity="Warning"
                Visibility="{shuxm:CollapsedWhenProcessElevated}"/>
            <TextBlock
                x:Name="WebView2LoadFailedHintText"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewWebView2WindowLoadFailedHint}"
                Visibility="Collapsed"/>
            <WebView2
                x:Name="WebView"
                Grid.Row="2"
                Margin="0"
                DefaultBackgroundColor="Transparent"/>
        </Grid>
        <materialcases:SwitchPresenter
            x:Name="GlassPresenter_4482"
            Margin="0,0,48,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:Button"
            Visibility="{Binding Visibility, ElementName=ToggleLockButton, Mode=OneWay}"
            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>0</x:Int32>
                </materialcases:Case.Value>
                <Button
                    x:Name="ToggleLockButton"
                    Height="48"
                    MinWidth="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{x:Bind ToggleLockCommand}"
                    Content="&#xE785;"
                    DataContext="{Binding DataContext, ElementName=GlassPresenter_4482, Mode=OneWay}"
                    FontSize="12"
                    RequestedTheme="{Binding ActualTheme, ElementName=GlassPresenter_4482, Mode=OneWay}"
                    Style="{StaticResource NavigationBackButtonSmallStyle}"/>
            </materialcases:Case>
            <materialcases:Case>
                <materialcases:Case.Value>
                    <x:Int32>1</x:Int32>
                </materialcases:Case.Value>
                <materialcontrols:LiquidGlassButton
                    x:Name="ToggleLockButtonGlass"
                    Width="{Binding Width, ElementName=ToggleLockButton, Mode=OneWay}"
                    Height="{Binding Height, ElementName=ToggleLockButton, Mode=OneWay}"
                    MinWidth="{Binding MinWidth, ElementName=ToggleLockButton, Mode=OneWay}"
                    MinHeight="{Binding MinHeight, ElementName=ToggleLockButton, Mode=OneWay}"
                    MaxWidth="{Binding MaxWidth, ElementName=ToggleLockButton, Mode=OneWay}"
                    MaxHeight="{Binding MaxHeight, ElementName=ToggleLockButton, Mode=OneWay}"
                    Padding="{Binding Padding, ElementName=ToggleLockButton, Mode=OneWay}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    materialtheme:ControlMaterialState.IsManaged="True"
                    materialtheme:ControlMaterialState.NativeControl="{Binding ElementName=ToggleLockButton}"
                    BorderThickness="{Binding BorderThickness, ElementName=ToggleLockButton, Mode=OneWay}"
                    Command="{Binding Command, ElementName=ToggleLockButton, Mode=OneWay}"
                    CommandParameter="{Binding CommandParameter, ElementName=ToggleLockButton, Mode=OneWay}"
                    Content="{Binding Content, ElementName=ToggleLockButton, Mode=OneWay}"
                    FlowDirection="{Binding FlowDirection, ElementName=ToggleLockButton, Mode=OneWay}"
                    FontFamily="{Binding FontFamily, ElementName=ToggleLockButton, Mode=OneWay}"
                    FontSize="{Binding FontSize, ElementName=ToggleLockButton, Mode=OneWay}"
                    FontStyle="{Binding FontStyle, ElementName=ToggleLockButton, Mode=OneWay}"
                    FontWeight="{Binding FontWeight, ElementName=ToggleLockButton, Mode=OneWay}"
                    Foreground="{Binding Foreground, ElementName=ToggleLockButton, Mode=OneWay}"
                    IsEnabled="{Binding IsEnabled, ElementName=ToggleLockButton, Mode=OneWay}"
                    Style="{StaticResource NavigationBackButtonSmallStyle}"/>
            </materialcases:Case>
        </materialcases:SwitchPresenter>
    </Grid>

</Window>
